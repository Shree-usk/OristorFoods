// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [pg_trgm]
}

// --- Auth.js (NextAuth) required models ---
// Minimal schema to make the PrismaAdapter compile and run. Full customer
// profile fields (addresses, reward wallet, etc.) belong to the Customer
// Platform epic (STORY-033/034); admin roles/permissions belong to
// STORY-038. Do not extend this beyond auth's requirements here.

model User {
  id                String     @id @default(cuid())
  name              String?
  email             String?    @unique
  emailVerified     DateTime?
  image             String?
  passwordHash      String?
  // STORY-033. `passwordChangedAt` doubles as the JWT session's
  // invalidation stamp (see src/lib/auth.ts) — a reset bumps it so
  // sessions issued before the reset stop verifying.
  passwordChangedAt DateTime?
  marketingOptIn    Boolean    @default(false)
  // STORY-071. Drives resolvePrice()'s customer-group pricing tier —
  // every call site used to hardcode "Retail" since this field never
  // existed. See docs/architecture-decisions.md's STORY-024/STORY-071 entries.
  customerGroup     CustomerGroup @default(Retail)
  accounts          Account[]
  sessions          Session[]
  wishlist          Wishlist?
  cart              Cart?
  reviews           Review[]   @relation("ReviewAuthor")
  questions         Question[] @relation("QuestionAsker")
  blogComments      BlogComment[]
  recipeReviews     RecipeReview[]
  recipeBookmarks   RecipeBookmark[]
  recipeQuestions   RecipeQuestion[] @relation("RecipeQuestionAsker")
  addresses         Address[]
  orders            Order[]
  couponRedemptions CouponRedemption[]
  rewardAccount      RewardAccount?
  rewardTransactions RewardTransaction[]
  badges             CustomerBadge[]
  // STORY-031.
  referralCode       ReferralCode?
  referralsMade      ReferralAttribution[] @relation("Referrer")
  referredBy         ReferralAttribution?  @relation("Referred")
  // STORY-032.
  notificationPreference NotificationPreference?
  notificationLogs       NotificationLog[]
  // STORY-036.
  supportTickets          SupportTicket[]
  // STORY-034.
  phone                   String?
  dateOfBirth             DateTime?
  // Set at email-change request time, swapped into `email` only once the
  // mailed verification link is confirmed (auth.service.ts-style token
  // flow) — `email` itself never changes until then. See
  // docs/architecture-decisions.md.
  pendingEmail            String?
  status                  AccountStatus @default(Active)
  deactivationReason      String?
  deactivationRequestedAt DateTime?
  // STORY-048. Set only when status is Suspended — an admin-initiated
  // block, distinct from the customer-initiated deactivation* fields
  // above.
  suspendedReason         String?
  suspendedAt             DateTime?
  suspendedById           String?
  suspendedBy             AdminUser? @relation(fields: [suspendedById], references: [id], onDelete: SetNull)
  loginEvents             LoginEvent[]
  adminNotes              AdminNote[]
  restrictedCoupons       Coupon[]
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
}

enum AccountStatus {
  Active
  DeactivationRequested
  Deactivated
  // STORY-048. Admin-initiated (fraud/abuse/policy), distinct from the
  // customer's own DeactivationRequested/Deactivated above — conflating
  // the two would make it impossible to tell "customer left" from
  // "admin blocked this account" apart in reporting. Only this value
  // blocks storefront login (auth.service.ts::verifyCredentials);
  // Deactivated remains the inert, unenforced value STORY-034 left it.
  Suspended
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// --- Product Catalogue (STORY-009) ---

enum ContentStatus {
  Active
  Inactive
}

model Category {
  id          String        @id @default(cuid())
  name        String
  slug        String        @unique
  description String?
  image       String?
  sortOrder   Int           @default(0)
  status      ContentStatus @default(Active)

  parentId String?
  parent   Category?  @relation("CategoryToParent", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryToParent")

  metaTitle       String?
  metaDescription String?
  canonicalUrl    String?
  ogImage         String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]
  couponScopeRefs    CouponScopeCategory[]
  promotionScopeRefs PromotionScopeCategory[]

  @@index([parentId])
}

model Brand {
  id          String  @id @default(cuid())
  name        String
  slug        String  @unique
  logo        String?
  description String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]
}

model Collection {
  id          String        @id @default(cuid())
  name        String
  slug        String        @unique
  description String?
  status      ContentStatus @default(Active)
  rules       Json?
  startDate   DateTime?
  endDate     DateTime?

  metaTitle       String?
  metaDescription String?
  canonicalUrl    String?
  ogImage         String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]
}

enum ProductStatus {
  Draft
  Review
  Published
  Archived
  Discontinued
  OutOfSeason
}

enum ProductType {
  Standard
  Bundle
  GiftPack
  Seasonal
  LimitedEdition
}

model Product {
  id                 String        @id @default(cuid())
  sku                String        @unique
  barcode            String?       @unique
  slug               String        @unique
  name               String
  shortDescription   String?
  story              String?
  status             ProductStatus @default(Draft)
  productType        ProductType   @default(Standard)
  publishedAt        DateTime?
  rewardPoints       Int           @default(0)
  inStock            Boolean       @default(true)
  stockQuantity      Int           @default(0)
  // Nullable on purpose: a weight-based delivery zone fails safe with a
  // "contact us for a quote" result when any cart line lacks a weight.
  weightGrams        Int?
  benefits           String[]      @default([])
  servingSuggestions String[]      @default([])

  brandId String?
  brand   Brand?  @relation(fields: [brandId], references: [id], onDelete: SetNull)

  categories  Category[]
  collections Collection[]

  metaTitle       String?
  metaDescription String?
  canonicalUrl    String?
  ogImage         String?

  // STORY-040. Nullable — products seeded before this story, or seeded by
  // scripts rather than an admin, have neither. SetNull (not Cascade/Restrict)
  // mirrors Review.reviewedById: deleting the admin account must never
  // delete or block deleting the product they touched.
  createdById String?
  createdBy   AdminUser? @relation("ProductCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById String?
  updatedBy   AdminUser? @relation("ProductUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  images            ProductImage[]
  videos            ProductVideo[]
  nutrition         ProductNutrition?
  ingredients       ProductIngredient[]
  allergens         Allergen[]
  certifications    Certification[]
  bundle            ProductBundle?
  bundleComponentOf BundleItem[]

  standardPrices      StandardPrice[]
  salePrices          SalePrice[]
  campaignPrices      CampaignPrice[]
  customerGroupPrices CustomerGroupPrice[]
  volumeDiscountTiers VolumeDiscountTier[]
  wishlistItems       WishlistItem[]
  cartItems           CartItem[]
  orderItems          OrderItem[]
  couponScopeRefs     CouponScopeProduct[]
  promotionScopeRefs  PromotionScopeProduct[]
  reviews             Review[]
  ratingSummary       ProductRatingSummary?
  questions           Question[]
  recipeIngredients   RecipeIngredient[]
  cookingTipRefs      CookingTipProductRef[]
  foodAcademyRefs     FoodAcademyProductRef[]

  @@index([status])
  @@index([status, inStock])
  @@index([brandId])
}

model Wishlist {
  id        String         @id @default(cuid())
  userId    String         @unique
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     WishlistItem[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
}

model WishlistItem {
  id         String   @id @default(cuid())
  wishlistId String
  wishlist   Wishlist @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  addedAt    DateTime @default(now())

  @@unique([wishlistId, productId])
  @@index([productId])
}

enum MediaRole {
  Gallery
  Lifestyle
  Video
}

model ProductImage {
  id        String    @id @default(cuid())
  productId String
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  altText   String?
  isPrimary Boolean   @default(false)
  mediaRole MediaRole @default(Gallery)
  sortOrder Int       @default(0)

  createdAt DateTime @default(now())

  @@index([productId])
}

model ProductVideo {
  id        String    @id @default(cuid())
  productId String
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  altText   String?
  isPrimary Boolean   @default(false)
  mediaRole MediaRole @default(Video)
  sortOrder Int       @default(0)

  createdAt DateTime @default(now())

  @@index([productId])
}

model ProductNutrition {
  id            String  @id @default(cuid())
  productId     String  @unique
  product       Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  servingSize   String
  calories      Decimal @db.Decimal(10, 2)
  protein       Decimal @db.Decimal(10, 2)
  fat           Decimal @db.Decimal(10, 2)
  saturatedFat  Decimal @db.Decimal(10, 2)
  carbohydrates Decimal @db.Decimal(10, 2)
  sugar         Decimal @db.Decimal(10, 2)
  fibre         Decimal @db.Decimal(10, 2)
  sodium        Decimal @db.Decimal(10, 2)
}

model ProductIngredient {
  id         String  @id @default(cuid())
  productId  String
  product    Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  name       String
  isAllergen Boolean @default(false)
  sortOrder  Int     @default(0)

  @@index([productId])
}

model Allergen {
  id       String    @id @default(cuid())
  name     String    @unique
  icon     String?
  products Product[]
}

model Certification {
  id               String    @id @default(cuid())
  name             String
  certificateImage String?
  documentUrl      String?
  products         Product[]
}

model ProductBundle {
  id            String       @id @default(cuid())
  productId     String       @unique
  product       Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  priceOverride Decimal?     @db.Decimal(10, 2)
  items         BundleItem[]
}

model BundleItem {
  id                 String        @id @default(cuid())
  bundleId           String
  bundle             ProductBundle @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  componentProductId String
  componentProduct   Product       @relation(fields: [componentProductId], references: [id])
  quantity           Int           @default(1)

  @@index([bundleId])
  @@index([componentProductId])
}

enum CustomerGroup {
  Retail
  Wholesale
  Distributor
  Export
  PrivateLabel
}

model StandardPrice {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  price     Decimal  @db.Decimal(10, 2)
  currency  String   @default("LKR")
  createdAt DateTime @default(now())

  @@index([productId])
}

model SalePrice {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  price     Decimal  @db.Decimal(10, 2)
  currency  String   @default("LKR")
  startDate DateTime
  endDate   DateTime
  createdAt DateTime @default(now())

  @@index([productId, startDate, endDate])
}

model CampaignPrice {
  id         String   @id @default(cuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  campaignId String
  price      Decimal  @db.Decimal(10, 2)
  currency   String   @default("LKR")
  startDate  DateTime
  endDate    DateTime
  createdAt  DateTime @default(now())

  @@index([productId, startDate, endDate])
}

model CustomerGroupPrice {
  id            String        @id @default(cuid())
  productId     String
  product       Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  customerGroup CustomerGroup
  price         Decimal       @db.Decimal(10, 2)
  currency      String        @default("LKR")
  createdAt     DateTime      @default(now())

  @@unique([productId, customerGroup])
}

model VolumeDiscountTier {
  id              String   @id @default(cuid())
  productId       String
  product         Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  minQuantity     Int
  discountPrice   Decimal? @db.Decimal(10, 2)
  discountPercent Decimal? @db.Decimal(5, 2)
  currency        String   @default("LKR")
  createdAt       DateTime @default(now())

  @@index([productId, minQuantity])
}

// STORY-015. Status lifecycle and transitions: see
// docs/superpowers/specs/2026-09-23-product-reviews-design.md. Status is only
// ever changed through review.service.ts's changeReviewStatus().
enum ReviewStatus {
  Pending
  Approved
  Published
  Rejected
  Archived
  // STORY-045. "Remove from public view without deleting" — distinct from
  // Archived (a terminal admin action); Published <-> Hidden is reversible.
  Hidden
}

model Review {
  id                 String       @id @default(cuid())
  productId          String
  product            Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId             String
  user               User         @relation("ReviewAuthor", fields: [userId], references: [id], onDelete: Cascade)
  rating             Int
  title              String
  body               String
  status             ReviewStatus @default(Pending)
  isVerifiedPurchase Boolean      @default(false)

  // STORY-045 moderation console fields. reviewedById/reviewedAt/
  // moderatorNote were reserved ahead of time by STORY-015 (see that
  // story's own comment, now removed) but pointed reviewedBy at `User` —
  // a pre-STORY-038 mistake, since nothing wrote them yet, corrected here
  // to `AdminUser` (a moderator is an admin, never a customer `User` row).
  reviewedById    String?
  reviewedBy      AdminUser? @relation("ReviewModerator", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt      DateTime?
  moderatorNote   String?
  adminReplyBody  String?
  featured        Boolean    @default(false)

  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  images ReviewImage[]

  @@unique([productId, userId])
  @@index([productId, status, publishedAt])
}

// Created now so photo upload can be added later without a schema change.
// Unused until a storage provider is chosen (docs/blueprint.md Section 10).
model ReviewImage {
  id        String   @id @default(cuid())
  reviewId  String
  review    Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  url       String
  altText   String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@index([reviewId])
}

// One row per product that has at least one Published review. Recalculated
// inside the same transaction as any status change into or out of Published.
model ProductRatingSummary {
  productId     String   @id
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  averageRating Decimal  @db.Decimal(3, 2)
  reviewCount   Int
  count1        Int
  count2        Int
  count3        Int
  count4        Int
  count5        Int
  updatedAt     DateTime @updatedAt
}

// STORY-016. Lifecycle and transitions: see
// docs/superpowers/specs/2026-09-23-product-qa-design.md. Status only changes
// through qa.service.ts's answerQuestion() / changeQuestionStatus().
enum QuestionStatus {
  Pending
  Answered
  Approved
  Published
  Rejected
}

model Question {
  id        String         @id @default(cuid())
  productId String
  product   Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId    String
  user      User           @relation("QuestionAsker", fields: [userId], references: [id], onDelete: Cascade)
  text      String
  status    QuestionStatus @default(Pending)

  // The official answer. Set by answerQuestion() on Pending → Answered.
  // answeredBy/approvedBy target AdminUser, not User -- a moderator is
  // staff, never a customer (STORY-046; same fix as Review.reviewedById
  // in STORY-045, caught here before anything had ever written to it).
  answerText   String?
  answeredById String?
  answeredBy   AdminUser? @relation("QuestionAnswerer", fields: [answeredById], references: [id], onDelete: SetNull)
  answeredAt   DateTime?

  // STORY-046. Separate approval step before Answered -> Published.
  approvedById String?
  approvedBy   AdminUser? @relation("QuestionApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedAt   DateTime?

  // STORY-046. Internal-only -- never shown to the customer. A question
  // rejected with a public decline is instead answered normally (the
  // decline text becomes the public answerText) rather than using this.
  rejectionReason String?

  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([productId, status, publishedAt])
  @@index([productId, userId, status])
}

// --- Recipes (STORY-017) ---
// Listing fields only. STORY-018 adds ingredients, steps, tips, nutrition and
// product links. Design: docs/superpowers/specs/2026-09-24-recipe-centre-design.md

// Publishing workflow (add-recipe skill). Only Published is ever shown on the
// storefront; STORY-043 owns the transitions.
enum RecipeStatus {
  Draft
  Review
  Approved
  Published
  Archived
}

enum RecipeDifficulty {
  Easy
  Medium
  Hard
}

enum VideoProvider {
  Youtube
  Vimeo
  SelfHosted
}

model RecipeCategory {
  id              String        @id @default(cuid())
  name            String
  slug            String        @unique
  description     String?
  image           String?
  sortOrder       Int           @default(0)
  status          ContentStatus @default(Active)
  metaTitle       String?
  metaDescription String?
  recipes         Recipe[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

model DietaryTag {
  id        String             @id @default(cuid())
  name      String             @unique
  slug      String             @unique
  icon      String?
  sortOrder Int                @default(0)
  status    ContentStatus      @default(Active)
  recipes   RecipeDietaryTag[]
}

model RecipeDietaryTag {
  recipeId     String
  recipe       Recipe     @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  dietaryTagId String
  dietaryTag   DietaryTag @relation(fields: [dietaryTagId], references: [id], onDelete: Cascade)

  @@id([recipeId, dietaryTagId])
  @@index([dietaryTagId])
}

model Recipe {
  id                   String             @id @default(cuid())
  slug                 String             @unique
  title                String
  shortDescription     String
  heroImage            String
  heroImageAlt         String
  categoryId           String
  category             RecipeCategory     @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  cuisine              String?
  difficulty           RecipeDifficulty
  prepTimeMinutes      Int
  cookTimeMinutes      Int
  // Always prep + cook, via computeTotalTimeMinutes() (src/lib/recipe-time.ts).
  // Stored so the time filter and sort can use an index.
  totalTimeMinutes     Int
  servings             Int
  status               RecipeStatus       @default(Draft)
  isFeatured           Boolean            @default(false)
  // Written by STORY-018 (views) and STORY-022 (ratings); seed values until then.
  viewCount            Int                @default(0)
  avgRating            Decimal?           @db.Decimal(2, 1)
  ratingCount          Int                @default(0)
  metaTitle            String?
  metaDescription      String?
  chefNotes            String?
  nutritionCalories    Int?
  nutritionProtein     Int?
  nutritionCarbs       Int?
  nutritionFat         Int?
  nutritionFiber       Int?
  nutritionSodium      Int?
  galleryImageUrls     String[]           @default([])
  videoUrl             String?
  videoProvider        VideoProvider?
  videoDurationSeconds Int?
  // Only meaningful when videoProvider is SelfHosted — a caption track
  // can't be injected into a cross-origin YouTube/Vimeo iframe.
  captionsUrl          String?
  ingredients          RecipeIngredient[]
  steps                RecipeStep[]
  dietaryTags          RecipeDietaryTag[]
  foodAcademyRefs      FoodAcademyRecipeRef[]
  recipeReviews        RecipeReview[]
  recipeBookmarks      RecipeBookmark[]
  // STORY-046.1.
  questions            RecipeQuestion[]
  // STORY-043. Shown to the author on the Draft a reviewer just rejected;
  // overwritten each rejection cycle — the full who/when/why history lives
  // in the audit log's metadata, not a separate comment-log table.
  reviewerComment      String?
  createdById          String?
  createdBy            AdminUser?         @relation("RecipeCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById          String?
  updatedBy            AdminUser?         @relation("RecipeUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  reviewedById         String?
  reviewedBy           AdminUser?         @relation("RecipeReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  publishedAt          DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  @@index([status, publishedAt])
  @@index([status, categoryId])
  @@index([status, totalTimeMinutes])
  @@index([status, viewCount])
  @@index([status, isFeatured])
}

model RecipeIngredient {
  id          String   @id @default(cuid())
  recipeId    String
  recipe      Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  productId   String?
  product     Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  quantity    Decimal? @db.Decimal(8, 2)
  unit        String?
  // Name/description ONLY — never includes quantity or unit. The rendered
  // line is always composed at read time as "{scaled quantity} {unit}
  // {displayText}" when quantity+unit are set, else just "{displayText}"
  // (see IngredientLink in Task 9). Baking "2 tbsp" into this field would
  // double up with the scaled quantity once servings are adjusted.
  displayText String
  sortOrder   Int

  @@index([recipeId, sortOrder])
  @@index([productId])
}

model RecipeStep {
  id          String  @id @default(cuid())
  recipeId    String
  recipe      Recipe  @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  stepNumber  Int
  instruction String
  imageUrl    String?

  @@unique([recipeId, stepNumber])
}

// --- Recipe Reviews & Bookmarks (STORY-022) ---

enum RecipeReviewStatus {
  Pending
  Approved
  Rejected
  Hidden
}

model RecipeReview {
  id         String             @id @default(cuid())
  recipeId   String
  recipe     Recipe             @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  customerId String
  customer   User               @relation(fields: [customerId], references: [id], onDelete: Cascade)
  rating     Int
  reviewText String?
  status     RecipeReviewStatus @default(Pending)
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  // STORY-045 moderation console fields, mirroring Review's own
  // (STORY-015) reserved-fields pattern — RecipeReview never had them.
  reviewedById   String?
  reviewedBy     AdminUser? @relation("RecipeReviewModerator", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt     DateTime?
  adminReplyBody String?
  featured       Boolean    @default(false)

  @@unique([recipeId, customerId])
  @@index([recipeId, status])
}

model RecipeBookmark {
  id         String   @id @default(cuid())
  recipeId   String
  recipe     Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  customerId String
  customer   User     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([recipeId, customerId])
  @@index([customerId])
  // STORY-037. listBookmarkedRecipeIdsForCustomer filters on customerId and
  // sorts by createdAt desc — this covers that query.
  @@index([customerId, createdAt])
}

// --- Recipe Q&A (STORY-046.1) ---
// A lightweight, isolated sibling of product Q&A (Question, STORY-016/046)
// — same 5-state pipeline, so QuestionStatus is reused directly rather than
// cloned (unlike ReviewStatus/RecipeReviewStatus, which differ in which
// states they have). Relation naming (customerId) follows RecipeReview/
// RecipeBookmark above, not Question's userId.

model RecipeQuestion {
  id         String         @id @default(cuid())
  recipeId   String
  recipe     Recipe         @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  customerId String
  customer   User           @relation("RecipeQuestionAsker", fields: [customerId], references: [id], onDelete: Cascade)
  text       String
  status     QuestionStatus @default(Pending)

  // Mirrors Question's answer fields exactly (STORY-046), including
  // targeting AdminUser from the start — a moderator is staff, never a
  // customer.
  answerText   String?
  answeredById String?
  answeredBy   AdminUser? @relation("RecipeQuestionAnswerer", fields: [answeredById], references: [id], onDelete: SetNull)
  answeredAt   DateTime?

  approvedById String?
  approvedBy   AdminUser? @relation("RecipeQuestionApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedAt   DateTime?

  // Internal-only — never shown to the customer.
  rejectionReason String?

  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([recipeId, status, publishedAt])
  @@index([recipeId, customerId, status])
}

// --- Cooking Tips (STORY-019) ---
// Short-form video/photo tips, independent of the Recipe Centre. Design:
// docs/superpowers/specs/2026-09-25-video-cooking-tips-design.md.

enum CookingTipStatus {
  Draft
  Published
}

model CookingTip {
  id            String           @id @default(cuid())
  slug          String           @unique
  title         String
  summary       String
  // Plain text, not markdown — rendered with whitespace-pre-line. See
  // design doc decision 5.
  bodyContent   String
  videoUrl      String?
  videoProvider VideoProvider?
  imageUrl      String?
  topicTag      String
  status        CookingTipStatus @default(Draft)
  publishedAt   DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  productRefs CookingTipProductRef[]

  @@index([status, publishedAt])
  @@index([status, topicTag])
}

model CookingTipProductRef {
  id           String     @id @default(cuid())
  cookingTipId String
  cookingTip   CookingTip @relation(fields: [cookingTipId], references: [id], onDelete: Cascade)
  productId    String
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([cookingTipId, productId])
  @@index([productId])
}

// --- Food Academy (STORY-020) ---
// Long-form food education content (articles, guides, courses), independent
// of the Recipe Centre and Cooking Tips. Design:
// .superpowers/sdd/2026-09-26-food-academy/

enum FoodAcademyEntryStatus {
  Draft
  Published
}

enum FoodAcademyContentType {
  Article
  Guide
  Course
}

model FoodAcademyCategory {
  id          String               @id @default(cuid())
  name        String
  slug        String               @unique
  description String?
  sortOrder   Int                  @default(0)
  status      ContentStatus        @default(Active)
  entries     FoodAcademyEntry[]
}

model FoodAcademyEntry {
  id           String                  @id @default(cuid())
  slug         String                  @unique
  title        String
  summary      String
  heroImageUrl String?
  contentType  FoodAcademyContentType
  categoryId   String
  category     FoodAcademyCategory     @relation(fields: [categoryId], references: [id])
  // Markdown. Required in practice for Article/Guide, an optional short
  // intro for Course (whose real content lives in `sections`). There is no
  // create/update API in this story's scope — this is a seed-data
  // convention, not a runtime-validated one (mirrors CookingTip's
  // createCookingTip being seed-only).
  bodyContent  String?
  readingTimeMinutes Int?
  authorName   String?
  isFeatured   Boolean                 @default(false)
  status       FoodAcademyEntryStatus  @default(Draft)
  publishedAt  DateTime?
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt

  sections    FoodAcademySection[]
  recipeRefs  FoodAcademyRecipeRef[]
  productRefs FoodAcademyProductRef[]

  @@index([status, publishedAt])
  @@index([status, categoryId])
  @@index([status, contentType])
  @@index([status, isFeatured])
}

model FoodAcademySection {
  id            String           @id @default(cuid())
  entryId       String
  entry         FoodAcademyEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  sectionNumber Int
  title         String
  bodyContent   String
  imageUrl      String?

  @@unique([entryId, sectionNumber])
}

model FoodAcademyRecipeRef {
  id       String           @id @default(cuid())
  entryId  String
  entry    FoodAcademyEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  recipeId String
  recipe   Recipe           @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@unique([entryId, recipeId])
  @@index([recipeId])
}

model FoodAcademyProductRef {
  id        String           @id @default(cuid())
  entryId   String
  entry     FoodAcademyEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  productId String
  product   Product          @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([entryId, productId])
  @@index([productId])
}

// --- Blog (STORY-021) ---
// Customer-facing blog: brand stories, recipes tie-ins and cooking content,
// independent of the Recipe Centre, Cooking Tips and Food Academy. Design:
// .superpowers/sdd/2026-09-26-blog/

enum BlogPostStatus {
  Draft
  Scheduled
  Published
  Archived
}

enum BlogCommentStatus {
  Pending
  Approved
  Rejected
  Hidden
}

model BlogAuthor {
  id        String     @id @default(cuid())
  name      String
  slug      String     @unique
  bio       String?
  avatarUrl String?
  posts     BlogPost[]
}

model BlogTag {
  id    String        @id @default(cuid())
  name  String
  slug  String        @unique
  posts BlogPostTag[]
}

model BlogPost {
  id                 String         @id @default(cuid())
  slug               String         @unique
  title              String
  heroImageUrl       String?
  excerpt            String
  bodyContent        String
  authorId           String
  author             BlogAuthor     @relation(fields: [authorId], references: [id])
  readingTimeMinutes Int?
  status             BlogPostStatus @default(Draft)
  publishedAt        DateTime?
  metaTitle          String?
  metaDescription    String?
  ogImage            String?
  // STORY-044. Internal "who authored this in the console" audit trail —
  // independent of `authorId`/`author`, which is the curated public byline
  // (e.g. "The Oristor Kitchen Team") and stays unchanged.
  createdById        String?
  createdBy          AdminUser?     @relation("BlogPostCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById        String?
  updatedBy          AdminUser?     @relation("BlogPostUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  tags     BlogPostTag[]
  comments BlogComment[]

  @@index([status, publishedAt])
  @@index([status, authorId])
}

model BlogPostTag {
  id     String   @id @default(cuid())
  postId String
  post   BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  tagId  String
  tag    BlogTag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([postId, tagId])
  @@index([tagId])
}

model BlogComment {
  id             String            @id @default(cuid())
  postId         String
  post           BlogPost          @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorName     String
  authorEmail    String
  customerId     String?
  customer       User?             @relation(fields: [customerId], references: [id])
  body           String
  status         BlogCommentStatus @default(Pending)
  // STORY-045. A CS reply, same shape as Review/RecipeReview's adminReplyBody.
  adminReplyBody String?
  createdAt      DateTime          @default(now())

  @@index([postId, status])
  @@index([postId, authorEmail, createdAt])
}

// --- Downloads & Resources (STORY-023) ---

enum DownloadResourceStatus {
  Draft
  Published
  Archived
}

model DownloadCategory {
  id        String             @id @default(cuid())
  name      String
  slug      String             @unique
  sortOrder Int                @default(0)
  resources DownloadResource[]
}

model DownloadResource {
  id            String                 @id @default(cuid())
  slug          String                 @unique
  title         String
  description   String?
  thumbnailUrl  String
  fileUrl       String
  fileType      String
  fileSizeBytes Int
  categoryId    String
  category      DownloadCategory       @relation(fields: [categoryId], references: [id])
  requiresAuth  Boolean                @default(false)
  status        DownloadResourceStatus @default(Draft)
  downloadCount Int                    @default(0)
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt

  @@index([status, categoryId])
}

// --- Shopping Cart (STORY-024) ---

model Cart {
  id         String     @id @default(cuid())
  userId     String?    @unique
  user       User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  guestToken String?    @unique
  items      CartItem[]
  // STORY-029. An FK, not a denormalized code, so it always reflects the
  // coupon's live state. Deliberately NOT copied over on a guest->user
  // merge (mergeGuestCartIntoUser) — see docs/architecture-decisions.md.
  couponId   String?
  coupon     Coupon?    @relation(fields: [couponId], references: [id], onDelete: SetNull)
  // STORY-030. Parallel to couponId, but a plain value, not an FK — a
  // redemption "request" isn't a durable row until order placement.
  // Requires an authenticated identity (a guest cart never meaningfully
  // sets this); enforced in rewards.service.ts and the /api/cart/points
  // route, not as a DB constraint.
  pointsToRedeem Int?   @default(0)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@index([guestToken])
}

model CartItem {
  id                String   @id @default(cuid())
  cartId            String
  cart              Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId         String
  product           Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity          Int
  unitPriceSnapshot Decimal  @db.Decimal(10, 2)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([cartId, productId])
}

// --- Coupons & Promotions (STORY-029) ---
// Customer-facing redemption/evaluation engine. Coupon/Promotion
// AUTHORING (an admin UI to create/edit these rows) is STORY-050's
// concern — this story only defines the schema STORY-050 will later
// write to, plus the service layer that reads it. `CampaignPrice`
// (STORY-009, per-product price override resolved in pricing.service.ts)
// and `Promotion` (cart-level discount, here) are related but distinct
// mechanisms operating at different layers — see
// docs/architecture-decisions.md, which also covers the stacking/
// precedence rule and the composition rule with tier pricing.

enum CouponDiscountType {
  PercentageOff
  FixedAmountOff
  FreeShipping
}

enum CouponScope {
  AllProducts
  Category
  Product
}

model Coupon {
  id           String             @id @default(cuid())
  code         String             @unique
  discountType CouponDiscountType
  // Used when discountType is PercentageOff (0-100). Null otherwise.
  percentOff   Decimal?           @db.Decimal(5, 2)
  // Used when discountType is FixedAmountOff. Null otherwise.
  amountOff    Decimal?           @db.Decimal(10, 2)
  currency     String             @default("LKR")
  startDate    DateTime
  endDate      DateTime
  minOrderValue Decimal?          @db.Decimal(10, 2)
  // Null = unlimited.
  usageLimitGlobal      Int?
  usageLimitPerCustomer Int?
  scope        CouponScope        @default(AllProducts)
  // Can this stack with other stackable coupons/promotions instead of
  // take-best? Default false matches the confirmed business default (no
  // stacking) — see docs/architecture-decisions.md.
  stackable    Boolean            @default(false)
  isActive     Boolean            @default(true)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  // STORY-048. Set only for a customer-admin-issued coupon
  // (coupon.service.ts::issueCouponToCustomer) — null for every
  // general-purpose coupon. validateCoupon() rejects redemption by
  // anyone else as CouponNotFoundError (not a distinct "forbidden"),
  // so a restricted coupon's existence can't be enumerated by a
  // different customer.
  restrictedToUserId String?
  restrictedToUser   User?   @relation(fields: [restrictedToUserId], references: [id], onDelete: Cascade)

  scopeProducts   CouponScopeProduct[]
  scopeCategories CouponScopeCategory[]
  redemptions     CouponRedemption[]
  carts           Cart[]

  @@index([code, isActive])
  @@index([startDate, endDate])
}

model CouponScopeProduct {
  couponId  String
  coupon    Coupon  @relation(fields: [couponId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([couponId, productId])
  @@index([productId])
}

model CouponScopeCategory {
  couponId   String
  coupon     Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([couponId, categoryId])
  @@index([categoryId])
}

// One row per successful redemption, written atomically with order
// creation (order.repository.ts's createOrderWithStockDecrement). The
// sole source of truth for usage-limit enforcement: the global limit is
// COUNT(*) WHERE couponId; the per-customer limit is COUNT(*) WHERE
// couponId AND (userId = X OR guestEmail = X) — see
// docs/architecture-decisions.md for why a guest's per-customer limit can
// only be enforced once an email exists, at place-order time.
model CouponRedemption {
  id             String   @id @default(cuid())
  couponId       String
  coupon         Coupon   @relation(fields: [couponId], references: [id], onDelete: Restrict)
  userId         String?
  user           User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  guestEmail     String?
  orderId        String   @unique
  order          Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  discountAmount Decimal  @db.Decimal(10, 2)
  createdAt      DateTime @default(now())

  @@index([couponId])
  @@index([couponId, userId])
  @@index([couponId, guestEmail])
}

// Automatic, no-code discount ("10% off all products this week"). Never
// "applied" to a Cart row like a Coupon — evaluated fresh on every read,
// since by definition it requires no customer action.
model Promotion {
  id           String             @id @default(cuid())
  name         String
  // Customer-facing label shown in the order summary, e.g. "Weekend Sale
  // — 10% off all products" — distinct from `name` (admin-facing), same
  // convention as DeliveryRateOverride.campaignName being customer-visible.
  displayLabel String
  discountType CouponDiscountType
  percentOff   Decimal?           @db.Decimal(5, 2)
  amountOff    Decimal?           @db.Decimal(10, 2)
  currency     String             @default("LKR")
  startDate    DateTime
  endDate      DateTime
  minOrderValue Decimal?          @db.Decimal(10, 2)
  scope        CouponScope        @default(AllProducts)
  stackable    Boolean            @default(false)
  // Tie-break among simultaneously-eligible promotions, and against a
  // non-stackable coupon of equal discount amount (the coupon always
  // wins that tie) — lower priority wins. See docs/architecture-decisions.md.
  priority     Int                @default(0)
  isActive     Boolean            @default(true)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  scopeProducts   PromotionScopeProduct[]
  scopeCategories PromotionScopeCategory[]

  @@index([isActive, startDate, endDate])
}

model PromotionScopeProduct {
  promotionId String
  promotion   Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  productId   String
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([promotionId, productId])
  @@index([productId])
}

model PromotionScopeCategory {
  promotionId String
  promotion   Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  categoryId  String
  category    Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([promotionId, categoryId])
  @@index([categoryId])
}

// --- Rewards / Loyalty Club (STORY-030) ---
// Ledger-backed points wallet + tier/badge progression. Admin authoring of
// rule VALUES (point amounts, tier cutoffs, conversion rate, expiry
// window, badge criteria) is STORY-049's concern; the customer-facing
// wallet dashboard is STORY-035's. This story defines the schema/config
// those will later manage/read, and owns the earn/redeem/reverse/expire
// mechanics — same "build the real schema before the owning admin story
// exists" pattern STORY-027 (ShippingSetting) and STORY-029
// (Coupon/Promotion) already established. Product.rewardPoints and
// Order(Item).rewardPointsEarned (STORY-009/024/025/028) already compute
// and snapshot the EARNED AMOUNT — untouched here; this section is what
// happens to that number afterward.

enum RewardTransactionType {
  Earned
  Redeemed
  Reversed
  Expired
  // STORY-031. Distinct from Earned/Reversed on purpose: a referral bonus
  // is written with orderId = the REFERRED customer's qualifying order
  // (not the referrer's own order), and reversePointsForCancelledOrder
  // (STORY-030) already writes its own `Reversed` row against that same
  // orderId when the referred customer's own earned points are clawed
  // back — reusing `Reversed` here would collide with @@unique([orderId,
  // type]). Neither of these two count toward lifetimeAchievement (only
  // Earned/Reversed do) — referring others doesn't advance the referrer's
  // own tier.
  ReferralBonus
  ReferralBonusReversed
  // Credited once at registration (orderId null) — see
  // docs/architecture-decisions.md.
  ReferralWelcomeBonus
}

// One row per user. Caches ONLY currentTierId — never a balance, which
// stays ledger-derived per the confirmed "auditable ledger, not a single
// mutable counter" requirement (docs/architecture-decisions.md).
model RewardAccount {
  id            String      @id @default(cuid())
  userId        String      @unique
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  currentTierId String?
  currentTier   RewardTier? @relation(fields: [currentTierId], references: [id], onDelete: SetNull)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

// The ledger — sole source of truth. `points` is SIGNED: Earned > 0;
// Redeemed/Reversed/Expired <= 0. Two derived sums matter and must never
// be conflated (see docs/architecture-decisions.md):
//   spendableBalance    = SUM(points) over ALL types
//   lifetimeAchievement = SUM(points) WHERE type IN (Earned, Reversed)
// A cancelled-and-clawed-back order nets its Earned+Reversed pair to
// zero in BOTH sums. Redeeming or letting points expire reduces
// spendableBalance only — never lifetimeAchievement, so spending points
// can never demote a customer's tier.
model RewardTransaction {
  id     String                @id @default(cuid())
  userId String
  user   User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  type   RewardTransactionType
  points Int
  orderId String?
  order   Order?               @relation(fields: [orderId], references: [id], onDelete: SetNull)
  // Set only on an Earned row, only when RewardSetting.pointsExpiryDays
  // was configured at write time. Null = this batch never expires.
  expiresAt DateTime?
  // Set ONLY on an Expired row: points back to the Earned row it closes
  // out. @@unique means at most one Expired row can ever close a given
  // Earned batch — the lazy sweep (rewards.service.ts) is idempotent, a
  // re-run can never double-expire the same batch.
  expiresEarnedTransactionId String?            @unique
  expiresEarnedTransaction   RewardTransaction? @relation("EarnedExpiry", fields: [expiresEarnedTransactionId], references: [id], onDelete: SetNull)
  expiredBy                  RewardTransaction? @relation("EarnedExpiry")
  note   String?
  createdAt DateTime @default(now())

  // At most one Earned, one Redeemed, one Reversed row per order — the
  // idempotency guard for event-driven earning/clawback (a replayed
  // order.confirmed/cancelled can't double-credit/debit) and for
  // transactional redemption. An order CAN legitimately hold both a
  // Redeemed row (points spent at that order's own checkout) and later
  // an Earned row (points that same purchase earns on confirmation) —
  // different (orderId, type) pairs, so this permits it correctly.
  // Expired rows are never order-linked (orderId null; Postgres treats
  // NULL as distinct in a unique index, so many can share it).
  @@unique([orderId, type])
  @@index([userId, createdAt])
  @@index([userId, type])
}

// Admin-configurable thresholds (STORY-049 will own the authoring UI);
// seeded here with defaults so the feature works before that UI exists.
model RewardTier {
  id                String          @id @default(cuid())
  name              String          @unique
  minLifetimePoints Int             @default(0)
  sortOrder         Int             @default(0)
  isActive          Boolean         @default(true)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  accounts          RewardAccount[]

  @@index([minLifetimePoints])
}

// Extensible criteria — a plain string, not an enum, mirroring
// OrderIntegrationEvent.eventType's precedent, so a future criteria type
// never needs a migration. Evaluated by rewards.service.ts's dispatch; an
// unrecognized criteriaType fails safe (never awarded), never throws.
model Badge {
  id           String          @id @default(cuid())
  code         String          @unique
  name         String
  description  String?
  // "first_order" | "order_count" | "lifetime_points"
  criteriaType String
  // Interpreted per criteriaType; null for first_order.
  threshold    Int?
  isActive     Boolean         @default(true)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  customers    CustomerBadge[]
}

// Badges, once earned, are never revoked on order cancellation (unlike
// points) — see docs/architecture-decisions.md.
model CustomerBadge {
  id       String   @id @default(cuid())
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  badgeId  String
  badge    Badge    @relation(fields: [badgeId], references: [id], onDelete: Cascade)
  earnedAt DateTime @default(now())
  orderId  String?
  order    Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@unique([userId, badgeId])
  @@index([userId])
}

// Singleton row (id "global") — mirrors ShippingSetting's precedent.
// Every value is nullable: absence means that behavior is OFF (fails
// safe — no award/redeem, checkout still completes), never a schema
// default silently turning a feature on.
model RewardSetting {
  id                          String   @id @default("global")
  // Currency units of discount per 1 redeemed point. Null = redemption
  // disabled entirely.
  pointsToCurrencyRate        Decimal? @db.Decimal(10, 4)
  // Absolute per-order redemption cap, independent of balance. Null = no
  // separate cap (balance remains the only bound).
  maxRedeemablePointsPerOrder Int?
  // Days after which an Earned batch expires. Null = points never expire
  // (current default — no admin UI exists yet to set this).
  pointsExpiryDays            Int?
  // Reserved for a future order-value-based earning mode (the AC's
  // "and/or" wording) — NOT read by any code in this story. See
  // docs/architecture-decisions.md for why a second earning formula
  // isn't built now.
  orderValuePointsRate        Decimal? @db.Decimal(10, 4)
  updatedAt                   DateTime @updatedAt
}

// --- Checkout (STORY-025) ---
// Thin slices of STORY-026 (Payment), STORY-027 (Shipping), and STORY-028
// (Orders) live here too — see docs/superpowers/specs/2026-09-28-checkout-design.md.

// Saved addresses exist only for authenticated users. STORY-025 (checkout)
// created this model minimally; STORY-034 owns full management (add/edit/
// delete, independent default-billing/default-shipping, business/
// distributor fields). Guest addresses are never stored here — only as the
// immutable ship* snapshot on Order (no FK from Order to Address at all —
// see docs/architecture-decisions.md's STORY-034 entry for why the AC's
// "deleting an address referenced by an order" guard doesn't apply here).
model Address {
  id                String       @id @default(cuid())
  userId            String
  user              User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  label             AddressLabel @default(Home)
  type              AddressType  @default(Both)
  recipientName     String
  phone             String
  line1             String
  line2             String?
  city              String
  // Doubles as Sri Lanka's "district" and international "state/province" —
  // same administrative-region concept, one column, label picked by
  // country in the UI. See STORY-034's architecture-decisions.md entry.
  district          String?
  postalCode        String?
  country           String       @default("LK")
  // Distributor persona (STORY-034 AC): present only when `type` covers a
  // business use; never validated as required, since most addresses aren't.
  companyName       String?
  taxId             String?
  isDefaultBilling  Boolean      @default(false)
  isDefaultShipping Boolean      @default(false)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@index([userId])
}

enum AddressLabel {
  Home
  Work
  Other
}

enum AddressType {
  Shipping
  Billing
  Both
}

enum DeliveryRateType {
  Flat
  WeightBased
  ValueBased
}

model DeliveryZone {
  id        String                 @id @default(cuid())
  name      String                 @unique
  // Matched case/whitespace-insensitively via normalizeCity(); stored
  // values keep their display casing.
  cities    String[]
  isActive  Boolean                @default(true)
  rate      DeliveryRate?
  overrides DeliveryRateOverride[]
  createdAt DateTime               @default(now())
  updatedAt DateTime               @updatedAt
}

model DeliveryRate {
  id               String           @id @default(cuid())
  zoneId           String           @unique
  zone             DeliveryZone     @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  rateType         DeliveryRateType
  flatAmount       Decimal?         @db.Decimal(10, 2)
  // [{ upTo: number, amount: string }] ascending — grams for WeightBased,
  // subtotal for ValueBased. Zod-validated at read time; malformed tiers
  // fail safe as config_error, never a silent 0 charge.
  tiers            Json?
  estimatedDaysMin Int?
  estimatedDaysMax Int?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
}

model DeliveryRateOverride {
  id             String       @id @default(cuid())
  zoneId         String
  zone           DeliveryZone @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  campaignName   String
  startsAt       DateTime
  endsAt         DateTime
  freeShipping   Boolean      @default(false)
  overrideAmount Decimal?     @db.Decimal(10, 2)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([zoneId, startsAt, endsAt])
}

// Singleton row (id "global") — the platform-wide free-shipping threshold
// is deliberately not a per-zone field (confirmed business decision).
model ShippingSetting {
  id                    String   @id @default("global")
  freeShippingThreshold Decimal  @db.Decimal(10, 2)
  updatedAt             DateTime @updatedAt
}

enum PaymentStatus {
  Pending
  Succeeded
  Failed
  Refunded
}

model Payment {
  id                String        @id @default(cuid())
  provider          String
  providerReference String        @unique
  status            PaymentStatus @default(Pending)
  amount            Decimal       @db.Decimal(10, 2)
  currency          String        @default("LKR")
  order             Order?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
}

enum OrderStatus {
  PendingConfirmation
  Confirmed
  Processing
  Dispatched
  Delivered
  Cancelled
  Returned
}

model Order {
  id                 String      @id @default(cuid())
  orderNumber        String      @unique
  idempotencyKey     String      @unique
  userId             String?
  user               User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  // Verified guest-cart token snapshot: authorizes the guest's
  // confirmation view and idempotent-replay ownership check.
  guestToken         String?
  guestEmail         String?
  status             OrderStatus @default(Confirmed)
  subtotal           Decimal     @db.Decimal(10, 2)
  deliveryCharge     Decimal     @db.Decimal(10, 2)
  discount           Decimal     @db.Decimal(10, 2) @default(0)
  tax                Decimal     @db.Decimal(10, 2) @default(0)
  grandTotal         Decimal     @db.Decimal(10, 2)
  couponCode         String?
  // STORY-029. A plain display-string snapshot of what discounted the
  // order ("Coupon SAVE10" or "Weekend Sale") — not an FK, so it survives
  // a later-deleted/deactivated Coupon or Promotion row unchanged.
  discountLabel      String?
  rewardPointsEarned Int         @default(0)
  // STORY-030. Immutable snapshots of a points redemption applied at this
  // order's checkout — mirrors the discount/discountLabel pattern.
  pointsRedeemed        Int     @default(0)
  pointsRedemptionValue Decimal @db.Decimal(10, 2) @default(0)
  erpSyncStatus      String?
  // Set together by order.service.ts's cancelOrder() (STORY-028). No
  // separate refund-reference column — refund state lives on
  // Payment.status (Refunded); duplicating it here would be a second
  // source of truth.
  cancelledAt        DateTime?
  cancellationReason String?     @db.VarChar(500)
  paymentId          String?     @unique
  payment            Payment?    @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  deliveryZoneName   String
  estimatedDaysMin   Int?
  estimatedDaysMax   Int?
  // STORY-036. Nothing writes these yet — admin console (STORY-047) will;
  // this story only reads/displays them when present.
  carrier            String?
  trackingNumber     String?
  trackingUrl        String?
  // Immutable address snapshot — flattened copies, no relation, so later
  // edits to a saved Address can never alter historical orders.
  shipRecipientName  String
  shipPhone          String
  shipLine1          String
  shipLine2          String?
  shipCity           String
  shipDistrict       String?
  shipPostalCode     String?
  items              OrderItem[]
  statusHistory      OrderStatusHistory[]
  integrationEvents  OrderIntegrationEvent[]
  couponRedemption   CouponRedemption?
  rewardTransactions RewardTransaction[]
  badgesAwarded      CustomerBadge[]
  // STORY-031. The referral this order qualified (if any) — set on the
  // attribution, not here; this is just the inverse relation.
  referralAttributions ReferralAttribution[]
  // STORY-036.
  returnRequests     ReturnRequest[]
  supportTickets     SupportTicket[]
  // STORY-047.
  refundRecords      RefundRecord[]
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  @@index([userId])
}

model OrderItem {
  id                 String   @id @default(cuid())
  orderId            String
  order              Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId          String?
  product            Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  // Snapshots at time of purchase — never rely on live product data.
  productName        String
  productSku         String
  unitPrice          Decimal  @db.Decimal(10, 2)
  quantity           Int
  lineTotal          Decimal  @db.Decimal(10, 2)
  rewardPointsEarned Int      @default(0)
}

model OrderStatusHistory {
  id        String      @id @default(cuid())
  orderId   String
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    OrderStatus
  actor     String
  createdAt DateTime    @default(now())
}

// STORY-047. Payment.status alone can only say "refunded or not" — this
// is the ledger of individual refund actions (amount, reason, who),
// since an order can in principle see more than one partial refund over
// its life even though payment.service.ts's refundPayment() only
// supports a single refund call per payment today (see
// docs/architecture-decisions.md).
model RefundRecord {
  id            String    @id @default(cuid())
  orderId       String
  order         Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  amount        Decimal   @db.Decimal(10, 2)
  reason        String    @db.VarChar(500)
  processedById String
  processedBy   AdminUser @relation(fields: [processedById], references: [id])
  createdAt     DateTime  @default(now())

  @@index([orderId])
}

// --- Order History & Support (STORY-036) ---
// Customer-facing presentation layer on top of STORY-028's Order model.
// ReturnRequest/SupportTicket are request records only — admin-side
// moderation/reply UI is out of scope here (STORY-047). See
// docs/architecture-decisions.md for the full contract.

enum ReturnRequestStatus {
  Requested
  Approved
  Rejected
  Completed
}

// STORY-047. The admin's own categorization when processing a return —
// distinct from the free-text `reason` above, which is the customer's
// own words from when they (optionally) submitted the request.
enum ReturnReasonCode {
  Damaged
  WrongItem
  NotAsDescribed
  ChangedMind
  Other
}

model ReturnRequest {
  id        String              @id @default(cuid())
  orderId   String
  order     Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  // Snapshot of the affected lines at request time — mirrors OrderItem's
  // own snapshot convention, never joins live: [{orderItemId, productName, quantity}]
  items     Json
  reason    String              @db.VarChar(1000)
  status    ReturnRequestStatus @default(Requested)
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  // STORY-047. Set when an admin processes this request (or creates one
  // directly, admin-initiated, with no prior customer submission).
  reasonCode    ReturnReasonCode?
  processedById String?
  processedBy   AdminUser?        @relation(fields: [processedById], references: [id], onDelete: SetNull)
  processedAt   DateTime?
  restocked     Boolean           @default(false)

  @@index([orderId])
}

enum SupportTicketCategory {
  OrderIssue
  Product
  Delivery
  Billing
  Other
}

enum SupportTicketStatus {
  Open
  InProgress
  Resolved
  Closed
}

model SupportTicket {
  id        String                 @id @default(cuid())
  userId    String
  user      User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderId   String?
  order     Order?                 @relation(fields: [orderId], references: [id], onDelete: SetNull)
  category  SupportTicketCategory
  subject   String
  message   String                 @db.VarChar(4000)
  status    SupportTicketStatus    @default(Open)
  createdAt DateTime               @default(now())
  updatedAt DateTime               @updatedAt

  @@index([userId])
  @@index([userId, status])
}

// --- Order Management (STORY-028) ---
// The ERP/warehouse integration hook: a durable outbox, not a call to any
// named ERP's API. Which ERP system is unconfirmed per blueprint.md
// Section 10 — same treatment STORY-026 gives the payment gateway. See
// docs/architecture-decisions.md for the full contract.

enum OrderIntegrationEventStatus {
  Pending
  Processed
  Failed
}

model OrderIntegrationEvent {
  id        String                      @id @default(cuid())
  orderId   String
  order     Order                       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  // "order.confirmed" | "order.cancelled" at the TS layer
  // (order-integration.service.ts's OrderEventType) — a plain string here
  // so a future event type never needs a migration.
  eventType String
  payload   Json
  status    OrderIntegrationEventStatus @default(Pending)
  processedAt DateTime?
  error     String?
  createdAt DateTime                    @default(now())

  @@index([orderId])
  @@index([status, createdAt])
}

// --- Referral Programme (STORY-031) ---
// Every registered customer gets a shareable code (lazily generated on
// first request, or eagerly at registration). Attribution before
// registration lives ONLY in a signed cookie (src/lib/referral-token.ts)
// — no DB row until a referred visitor actually registers, mirroring the
// guest-cart pattern (no write on a mere click). ReferralAttribution is
// then created exactly once per referred customer (unique on
// referredUserId), never re-attributable afterward. Reward VALUES
// (bonus amount, minimum qualifying order value, attribution window) are
// admin-configurable (STORY-049 will own the authoring UI) — this story
// builds the real ReferralSetting schema, seeded with working defaults,
// same "build the real thing before the owning admin story exists"
// pattern STORY-027/029/030 already established. See
// docs/architecture-decisions.md for the full design.

enum ReferralAttributionStatus {
  Registered
  Qualified
  Excluded
}

model ReferralCode {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  code      String   @unique
  createdAt DateTime @default(now())
}

// One row per referred customer (never per click) — created at
// registration from whatever attribution cookie was present, if any.
model ReferralAttribution {
  id             String                    @id @default(cuid())
  referrerUserId String
  referrer       User                      @relation("Referrer", fields: [referrerUserId], references: [id], onDelete: Cascade)
  // @unique: structurally impossible to attribute the same customer
  // twice, from this or a later visit via a different referral link.
  referredUserId String                    @unique
  referred       User                      @relation("Referred", fields: [referredUserId], references: [id], onDelete: Cascade)
  status         ReferralAttributionStatus @default(Registered)
  // Free-text, extensible — e.g. "self_referral". Mirrors
  // Badge.criteriaType's "plain string, not enum" precedent.
  excludedReason String?
  qualifyingOrderId String?
  qualifyingOrder   Order?  @relation(fields: [qualifyingOrderId], references: [id], onDelete: SetNull)
  qualifiedAt    DateTime?
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt

  @@index([referrerUserId])
  @@index([status])
}

// Singleton row (id "global"). Unlike RewardSetting, this one is NOT left
// absent by default — an unconfigured referral program does nothing at
// all, so it ships seeded with real working defaults (prisma/seed-referrals.ts).
model ReferralSetting {
  id                         String   @id @default("global")
  // Points credited to the REFERRER when a referral qualifies.
  referrerBonusPoints        Int?
  // Minimum order subtotal (any currency unit the storefront uses) a
  // referred customer's order must reach to qualify. Null = any
  // confirmed order qualifies.
  minQualifyingOrderValue    Decimal? @db.Decimal(10, 2)
  // Null = falls back to a 30-day default (referral.service.ts).
  attributionWindowDays      Int?
  // Optional signup bonus for the REFERRED customer, credited once at
  // registration. Null = no welcome bonus (genuinely optional per the AC).
  referredWelcomeBonusPoints Int?
  updatedAt                  DateTime @updatedAt
}

// --- Notifications (STORY-032) ---
// Transactional (event-triggered, one-to-one) email/SMS/WhatsApp only —
// bulk marketing campaigns are STORY-050. Message COPY is a
// NotificationTemplate row, not a hardcoded string, per CLAUDE.md's
// Admin Console Principle — seeded with real working defaults
// (prisma/seed-notifications.ts) ahead of STORY-054's future authoring
// UI, the same "build the real thing before the admin story exists"
// pattern STORY-027/029/030/031 already established. See
// docs/architecture-decisions.md for the full design.

enum NotificationChannel {
  Email
  SMS
  WhatsApp
}

enum NotificationStatus {
  Sent
  Failed
  SkippedNoConsent
}

model NotificationTemplate {
  id         String              @id @default(cuid())
  // "order.confirmed" | "order.dispatched" | "order.delivered" |
  // "order.cancelled" | "rewards.points_earned" | "referral.qualified" —
  // a plain string, not an enum, mirroring OrderIntegrationEvent.eventType's
  // precedent, so a future notification type never needs a migration.
  templateKey String
  channel    NotificationChannel
  // Email only — null for SMS/WhatsApp.
  subject    String?
  // {{variableName}} placeholders, substituted by notification.service.ts.
  body       String
  isActive   Boolean             @default(true)
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  @@unique([templateKey, channel])
}

// One row per user — mirrors RewardAccount/ReferralCode as a satellite
// table rather than bloating User with columns. Email is deliberately
// NOT gated here (see NotificationLog/notification.service.ts) — this
// table only governs the two consent-requiring channels.
model NotificationPreference {
  id            String   @id @default(cuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  phone         String?
  // Order-lifecycle transactional emails (confirmed/dispatched/etc). Named
  // `emailOptIn` (not `orderUpdatesOptIn`) since it's the only email
  // category this app currently sends — kept the original STORY-032 name
  // to avoid an unnecessary rename migration; STORY-034's "promotional
  // emails" toggle is `User.marketingOptIn` instead (same concept already
  // captured at registration — no second field for it). See
  // docs/architecture-decisions.md.
  emailOptIn    Boolean  @default(true)
  smsOptIn      Boolean  @default(false)
  whatsappOptIn Boolean  @default(false)
  // STORY-034. Points-earned / referral-qualified notifications.
  rewardUpdatesOptIn Boolean @default(true)
  updatedAt     DateTime @updatedAt
}

// One row per attempted send. `triggeringEventId` deliberately spans
// multiple source tables (OrderIntegrationEvent.id for order-lifecycle
// notifications, RewardTransaction.id for points-earned,
// ReferralAttribution.id for referral-qualified, Review.id /
// RecipeReview.id for STORY-045's review.approved/recipe_review.approved)
// rather than being a strict FK to any one of them — same "plain string
// for extensibility" treatment as OrderIntegrationEvent.eventType.
// @@unique below is the duplicate-send guard: the same fact can never
// notify the same recipient on the same channel twice.
model NotificationLog {
  id                String              @id @default(cuid())
  // Null for a guest order-confirmation email — there is no User row to link.
  userId            String?
  user              User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  recipient         String
  channel           NotificationChannel
  templateKey       String
  status            NotificationStatus
  // "smtp" | "ethereal" | "mock-sms" | "mock-whatsapp".
  provider          String?
  providerReference String?
  error             String?
  triggeringEventId String
  createdAt         DateTime            @default(now())

  // channel is part of the key deliberately — two different channels for
  // the same event/template can otherwise share an identical recipient
  // value (e.g. both fall back to the "no contact" placeholder when
  // neither SMS nor WhatsApp has a phone on file), which would wrongly
  // collide without it.
  @@unique([triggeringEventId, templateKey, channel, recipient])
  @@index([userId])
}

// --- Admin Auth & RBAC (STORY-038) ---
// A deliberately separate authentication system from User/Account/Session
// above — a different NextAuth instance, a different session cookie, a
// different secret (ADMIN_AUTH_SECRET). No admin session can read a
// customer session or vice versa. See docs/architecture-decisions.md for
// the full design (permission matrix, cookie/secret separation, why
// RolePermission is sparse/existence-based, why Role has a separate stable
// `key` from its editable `name`).
//
// This pass ships the core only (separate auth, 12 seeded roles, the full
// permission matrix + server-side enforcement, audit logging, route
// guarding). Self-service email invite, admin password reset, and TOTP 2FA
// are explicitly deferred — see architecture-decisions.md — so AdminUser
// carries no invite/2FA fields yet; adding unused columns now would be
// speculative.

model Role {
  id            String           @id @default(cuid())
  // Stable machine identifier (e.g. "super_administrator"), separate from
  // `name` because the Super-Admin-floor and last-Super-Administrator
  // guards must key off something that survives a future rename via
  // STORY-057's role-editing UI.
  key           String           @unique
  name          String           @unique
  createdAt     DateTime         @default(now())
  adminUsers    AdminUser[]
  permissions   RolePermission[]
}

enum AdminModule {
  Products
  MediaLibrary
  HomepageBuilder
  Recipes
  Blog
  Reviews
  QA
  Orders
  Customers
  RewardsReferrals
  Marketing
  SEO
  Navigation
  CMSWorkflow
  SystemSettings
  DeliveryZones
  ERPIntegration
  UsersRolesAudit
  ExportPortal
  CRMAnalytics
}

enum AdminAction {
  View
  Edit
  Delete
  Approve
  Export
  Audit
}

// Sparse/existence-based: a row's presence means granted, absence means
// denied. Avoids seeding ~1,440 explicit "false" rows while still
// satisfying "independently configurable per module × action cell" and
// "stored in the database, not hardcoded."
model RolePermission {
  id        String      @id @default(cuid())
  roleId    String
  role      Role        @relation(fields: [roleId], references: [id], onDelete: Cascade)
  module    AdminModule
  action    AdminAction
  createdAt DateTime    @default(now())

  @@unique([roleId, module, action])
  @@index([roleId])
}

enum AdminUserStatus {
  Active
  Locked
  Deactivated
}

model AdminUser {
  id                 String          @id @default(cuid())
  email              String          @unique
  name               String
  passwordHash       String
  // Mirrors User.passwordChangedAt's role exactly — the JWT session-version
  // stamp checked on every request (see src/lib/admin-auth.ts). Bumping
  // this force-signs-out every outstanding session for this admin.
  passwordChangedAt  DateTime        @default(now())
  roleId             String
  role               Role            @relation(fields: [roleId], references: [id])
  status             AdminUserStatus @default(Active)
  failedLoginAttempts Int            @default(0)
  lockedUntil        DateTime?
  auditLogs          AuditLog[]
  // STORY-040.
  productsCreated    Product[]       @relation("ProductCreatedBy")
  productsUpdated    Product[]       @relation("ProductUpdatedBy")
  // STORY-041.
  mediaAssetsUploaded MediaAsset[]
  // STORY-042.
  homepageLayoutsCreated HomepageLayout[] @relation("HomepageLayoutCreatedBy")
  homepageLayoutsUpdated HomepageLayout[] @relation("HomepageLayoutUpdatedBy")
  // STORY-043.
  recipesCreated     Recipe[]        @relation("RecipeCreatedBy")
  recipesUpdated     Recipe[]        @relation("RecipeUpdatedBy")
  recipesReviewed    Recipe[]        @relation("RecipeReviewedBy")
  // STORY-044.
  blogPostsCreated   BlogPost[]      @relation("BlogPostCreatedBy")
  blogPostsUpdated   BlogPost[]      @relation("BlogPostUpdatedBy")
  // STORY-045.
  reviewsModerated       Review[]       @relation("ReviewModerator")
  recipeReviewsModerated RecipeReview[] @relation("RecipeReviewModerator")
  // STORY-046.
  questionsAnswered  Question[]      @relation("QuestionAnswerer")
  questionsApproved  Question[]      @relation("QuestionApprover")
  // STORY-046.1.
  recipeQuestionsAnswered RecipeQuestion[] @relation("RecipeQuestionAnswerer")
  recipeQuestionsApproved RecipeQuestion[] @relation("RecipeQuestionApprover")
  // STORY-047.
  refundsProcessed  RefundRecord[]
  returnsProcessed  ReturnRequest[]
  // STORY-048.
  customersSuspended User[]
  adminNotesAuthored AdminNote[]
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
}

// Minimal but real: used now for login/lockout/permission-denied events.
// Future admin-module stories (STORY-039+) call the same writeAuditLog
// helper for their own create/edit/delete/approve actions — this is the
// shared table, not a STORY-038-only log.
model AuditLog {
  id         String       @id @default(cuid())
  actorId    String?
  actor      AdminUser?   @relation(fields: [actorId], references: [id], onDelete: SetNull)
  // Free string, not the AdminAction enum — audit covers auth events
  // ("login_succeeded", "login_failed", "permission_denied",
  // "account_locked") as well as future module CRUD actions.
  action     String
  module     AdminModule?
  targetType String?
  targetId   String?
  metadata   Json?
  createdAt  DateTime     @default(now())

  @@index([actorId])
  @@index([createdAt])
}

// STORY-048. Customer-side login history — AuditLog above is
// AdminUser-only (STORY-038's admin audit trail) and never covered
// storefront logins. Written from auth.service.ts::verifyCredentials,
// the Credentials provider's sole verification path. A failed row is
// only written once a real user is matched (never for a nonexistent
// email), so this can't be used to enumerate registered addresses.
model LoginEvent {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  success   Boolean
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

// STORY-048. Internal-only support context, never surfaced on any
// customer-facing read path (profile.service.ts, etc.) — append-only,
// no edit/delete.
model AdminNote {
  id         String    @id @default(cuid())
  customerId String
  customer   User      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  authorId   String
  author     AdminUser @relation(fields: [authorId], references: [id])
  body       String    @db.VarChar(2000)
  createdAt  DateTime  @default(now())

  @@index([customerId, createdAt])
}

// --- Media Library (STORY-041, core scope) ---
// The reusable asset-selection source for every other content module's
// image/video field (Products STORY-040, and STORY-042/043/044 to come).
// `width`/`height` stay null until the deferred compression/WebP/variant
// pipeline lands — nothing in this pass needs them. No `MediaAssetUsage`
// table yet either: every existing image field (ProductImage.url,
// Recipe.heroImage, etc.) is still a plain string, and retrofitting them
// to a real FK-based usage guard is its own scoped follow-up — see
// docs/architecture-decisions.md.

model MediaFolder {
  id        String        @id @default(cuid())
  name      String
  parentId  String?
  parent    MediaFolder?  @relation("FolderToParent", fields: [parentId], references: [id], onDelete: SetNull)
  children  MediaFolder[] @relation("FolderToParent")
  assets    MediaAsset[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([parentId])
}

model MediaAssetTag {
  id     String       @id @default(cuid())
  name   String       @unique
  assets MediaAsset[]
}

enum MediaAssetType {
  Image
  Video
  Document
}

model MediaAsset {
  id           String          @id @default(cuid())
  // Safe, randomized on-disk name (`${cuid()}-${slugified-basename}.${ext}`)
  // — never the raw uploaded filename, so a crafted name can't traverse
  // paths or overwrite another asset's file.
  filename     String
  // The uploader's own filename, kept only for display/download naming.
  originalName String
  url          String
  mimeType     String
  type         MediaAssetType
  sizeBytes    Int
  width        Int?
  height       Int?
  // Required before AssetPickerDialog will let this asset be selected
  // (media.service.ts::assertAltTextForSelection) — enforced server-side,
  // not just a form-level nicety (AC).
  altText      String?
  folderId     String?
  folder       MediaFolder?    @relation(fields: [folderId], references: [id], onDelete: SetNull)
  tags         MediaAssetTag[]
  uploadedById String?
  uploadedBy   AdminUser?      @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([folderId])
  @@index([type])
}

// --- Homepage Visual Builder (STORY-042, core scope) ---
// The admin-side authoring model behind the storefront homepage
// (src/app/(storefront)/page.tsx, STORY-006). A layout is an ordered set
// of section instances; publishing swaps which layout is live and
// archives (never deletes) whichever layout was previously live, giving
// one-level rollback for free — see docs/architecture-decisions.md.
// Scheduling (auto-publish/expire) is deferred: no cron/job-runner exists
// in this codebase yet.

enum HomepageLayoutStatus {
  Draft
  Published
  Archived
}

enum HomepageSectionType {
  HeroBanner
  FeaturedCategories
  WhyChooseOristor
  BestSellingProducts
  FeaturedRecipes
  ProductCollections
  FoodAcademy
  CustomerReviews
  ExportSolutions
  RewardsClub
  InstagramGallery
}

enum ContentAlignment {
  Left
  Center
  Right
}

model HomepageLayout {
  id          String               @id @default(cuid())
  status      HomepageLayoutStatus @default(Draft)
  publishedAt DateTime?
  sections    HomepageSection[]
  createdById String?
  createdBy   AdminUser?           @relation("HomepageLayoutCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById String?
  updatedBy   AdminUser?           @relation("HomepageLayoutUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@index([status])
}

model HomepageSection {
  id       String              @id @default(cuid())
  layoutId String
  layout   HomepageLayout      @relation(fields: [layoutId], references: [id], onDelete: Cascade)
  type     HomepageSectionType
  sortOrder Int
  visible  Boolean             @default(true)
  // Light-touch override for the 10 non-HeroBanner types — null falls
  // back to that section's existing hardcoded/fixture heading. Unused
  // (always null) for HeroBanner, which uses HeroBannerSlide instead. A
  // layout may have at most one HeroBanner-type section (enforced in
  // homepage-builder.service.ts, not the schema — Prisma can't express a
  // conditional unique constraint); the other 10 types may repeat, since
  // duplicate-section is an explicit AC.
  titleOverride       String?
  descriptionOverride String?
  banners  HeroBannerSlide[]
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  @@index([layoutId])
}

model HeroBannerSlide {
  id                String           @id @default(cuid())
  sectionId         String
  section           HomepageSection  @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  sortOrder         Int
  visible           Boolean          @default(true)
  headline          String
  subheadline       String?
  supportingText    String?
  ctaLabel          String?
  ctaHref           String?
  secondaryCtaLabel String?
  secondaryCtaHref  String?
  desktopImageUrl   String
  desktopImageAlt   String
  mobileImageUrl    String?
  mobileImageAlt    String?
  videoUrl          String?
  overlayEnabled    Boolean          @default(false)
  alignment         ContentAlignment @default(Left)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([sectionId])
}
