// --- Blog (STORY-021) ---
// Customer-facing blog: brand stories, recipes tie-ins and cooking content,
// independent of the Recipe Centre, Cooking Tips and Food Academy. Design:
// .superpowers/sdd/2026-09-26-blog/

enum BlogPostStatus {
  Draft
  Scheduled
  Published
  Archived
}

enum BlogCommentStatus {
  Pending
  Approved
  Rejected
  Hidden
}

model BlogAuthor {
  id        String     @id @default(cuid())
  name      String
  slug      String     @unique
  bio       String?
  avatarUrl String?
  posts     BlogPost[]
}

model BlogTag {
  id    String        @id @default(cuid())
  name  String
  slug  String        @unique
  posts BlogPostTag[]
}

model BlogPost {
  id                 String         @id @default(cuid())
  slug               String         @unique
  title              String
  heroImageUrl       String?
  excerpt            String
  bodyContent        String
  authorId           String
  author             BlogAuthor     @relation(fields: [authorId], references: [id])
  readingTimeMinutes Int?
  status             BlogPostStatus @default(Draft)
  publishedAt        DateTime?
  // STORY-044. Internal "who authored this in the console" audit trail —
  // independent of `authorId`/`author`, which is the curated public byline
  // (e.g. "The Oristor Kitchen Team") and stays unchanged.
  createdById        String?
  createdBy          AdminUser?     @relation("BlogPostCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById        String?
  updatedBy          AdminUser?     @relation("BlogPostUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  tags     BlogPostTag[]
  comments BlogComment[]

  @@index([status, publishedAt])
  @@index([status, authorId])
}

model BlogPostTag {
  id     String   @id @default(cuid())
  postId String
  post   BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  tagId  String
  tag    BlogTag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([postId, tagId])
  @@index([tagId])
}

model BlogComment {
  id             String            @id @default(cuid())
  postId         String
  post           BlogPost          @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorName     String
  authorEmail    String
  customerId     String?
  customer       User?             @relation(fields: [customerId], references: [id])
  body           String
  status         BlogCommentStatus @default(Pending)
  // STORY-045. A CS reply, same shape as Review/RecipeReview's adminReplyBody.
  adminReplyBody String?
  createdAt      DateTime          @default(now())

  @@index([postId, status])
  @@index([postId, authorEmail, createdAt])
}

// --- SEO Console (STORY-051a, core scope) ---
// Polymorphic via (entityType, entityId) rather than a typed Prisma
// relation per entity — Prisma can't express a single FK pointing at one
// of several different models, and entityId's referential integrity
// isn't enforced at the DB level (same trade-off the story's own AC
// accepted by calling this "polymorphic"). Replaces the metaTitle/
// metaDescription/canonicalUrl/ogImage columns that used to live
// directly on Product/Recipe/BlogPost (each had its own copy, with no
// single source of truth) — see docs/architecture-decisions.md for the
// full migration reasoning. ogImageUrl/ogImageAlt are plain strings, not
// an ogImageId FK to MediaAsset, matching every other Media-Library-
// picked image field in this schema (PromotionalPopup.imageUrl,
// HeroBannerSlide.desktopImageUrl, etc.) — AssetPickerDialog's onSelect
// already hands back { url, altText }, never an id to store.
enum SeoEntityType {
  Product
  Recipe
  BlogPost
}

model SeoMeta {
  id              String        @id @default(cuid())
  entityType      SeoEntityType
  entityId        String
  metaTitle       String?
  metaDescription String?
  canonicalUrl    String?
  ogImageUrl      String?
  ogImageAlt      String?
  // STORY-051d. Captured from AssetPickerDialog's onSelect payload at the
  // same moment ogImageUrl/ogImageAlt are — not re-derived from MediaAsset
  // by URL at health-check time, which would be fragile (an admin can type
  // a URL by hand, with no MediaAsset row to look up). Feeds
  // computeSeoHealth's ogImageTooSmall check (src/lib/seo-health.ts).
  ogImageWidth    Int?
  ogImageHeight   Int?
  robotsIndex     Boolean       @default(true)
  robotsFollow    Boolean       @default(true)
  focusKeyword    String?
  // STORY-051c. A full replacement, not a merge — when set, the storefront
  // page renders exactly this instead of calling its own ProductJsonLd/
  // RecipeJsonLd/BlogJsonLd component at all. A partial merge risks
  // producing an invalid combined schema.org object from incomplete admin
  // input; a full override is simpler and predictable.
  jsonLdOverride  Json?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@unique([entityType, entityId])
}

// STORY-051b. Resolved in src/proxy.ts via a short-TTL in-memory cache
// (src/lib/redirect-cache.ts), not a DB query per request. Conflict
// detection (redirect.service.ts::detectRedirectConflict) bans any
// single 2-hop chain at create/update time — a cycle of any length
// requires at least one such link to exist at some point, so banning
// the link transitively bans every chain and loop too, with no graph
// traversal needed. statusCode is a plain Int (a real HTTP status
// code, not a semantic workflow state like this schema's other status
// enums) — Zod constrains it to 301|302 at the validation layer.
model Redirect {
  id              String     @id @default(cuid())
  sourcePath      String     @unique
  destinationPath String
  statusCode      Int        @default(301)
  active          Boolean    @default(true)
  createdById     String?
  createdBy       AdminUser? @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@index([active])
}

// --- Downloads & Resources (STORY-023) ---

enum DownloadResourceStatus {
  Draft
  Published
  Archived
}

model DownloadCategory {
  id        String             @id @default(cuid())
  name      String
  slug      String             @unique
  sortOrder Int                @default(0)
  resources DownloadResource[]
}

model DownloadResource {
  id            String                 @id @default(cuid())
  slug          String                 @unique
  title         String
  description   String?
  thumbnailUrl  String
  fileUrl       String
  fileType      String
  fileSizeBytes Int
  categoryId    String
  category      DownloadCategory       @relation(fields: [categoryId], references: [id])
  requiresAuth  Boolean                @default(false)
  status        DownloadResourceStatus @default(Draft)
  downloadCount Int                    @default(0)
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt

  @@index([status, categoryId])
}

// --- Shopping Cart (STORY-024) ---

model Cart {
  id         String     @id @default(cuid())
  userId     String?    @unique
  user       User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  guestToken String?    @unique
  items      CartItem[]
  // STORY-029. An FK, not a denormalized code, so it always reflects the
  // coupon's live state. Deliberately NOT copied over on a guest->user
  // merge (mergeGuestCartIntoUser) — see docs/architecture-decisions.md.
  couponId   String?
  coupon     Coupon?    @relation(fields: [couponId], references: [id], onDelete: SetNull)
  // STORY-030. Parallel to couponId, but a plain value, not an FK — a
  // redemption "request" isn't a durable row until order placement.
  // Requires an authenticated identity (a guest cart never meaningfully
  // sets this); enforced in rewards.service.ts and the /api/cart/points
  // route, not as a DB constraint.
  pointsToRedeem Int?   @default(0)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@index([guestToken])
}

model CartItem {
  id                String   @id @default(cuid())
  cartId            String
  cart              Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId         String
  product           Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity          Int
  unitPriceSnapshot Decimal  @db.Decimal(10, 2)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([cartId, productId])
}

// --- Coupons & Promotions (STORY-029) ---
// Customer-facing redemption/evaluation engine. Coupon/Promotion
// AUTHORING (an admin UI to create/edit these rows) is STORY-050's
// concern — this story only defines the schema STORY-050 will later
// write to, plus the service layer that reads it. `CampaignPrice`
// (STORY-009, per-product price override resolved in pricing.service.ts)
// and `Promotion` (cart-level discount, here) are related but distinct
// mechanisms operating at different layers — see
// docs/architecture-decisions.md, which also covers the stacking/
// precedence rule and the composition rule with tier pricing.

enum CouponDiscountType {
  PercentageOff
  FixedAmountOff
  FreeShipping
}

enum CouponScope {
  AllProducts
  Category
  Product
}

model Coupon {
  id           String             @id @default(cuid())
  code         String             @unique
  discountType CouponDiscountType
  // Used when discountType is PercentageOff (0-100). Null otherwise.
  percentOff   Decimal?           @db.Decimal(5, 2)
  // Used when discountType is FixedAmountOff. Null otherwise.
  amountOff    Decimal?           @db.Decimal(10, 2)
  currency     String             @default("LKR")
  startDate    DateTime
  endDate      DateTime
  minOrderValue Decimal?          @db.Decimal(10, 2)
  // Null = unlimited.
  usageLimitGlobal      Int?
  usageLimitPerCustomer Int?
  scope        CouponScope        @default(AllProducts)
  // Can this stack with other stackable coupons/promotions instead of
  // take-best? Default false matches the confirmed business default (no
  // stacking) — see docs/architecture-decisions.md.
  stackable    Boolean            @default(false)
  isActive     Boolean            @default(true)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  // STORY-048. Set only for a customer-admin-issued coupon
  // (coupon.service.ts::issueCouponToCustomer) — null for every
  // general-purpose coupon. validateCoupon() rejects redemption by
  // anyone else as CouponNotFoundError (not a distinct "forbidden"),
  // so a restricted coupon's existence can't be enumerated by a
  // different customer.
  restrictedToUserId String?
  restrictedToUser   User?   @relation(fields: [restrictedToUserId], references: [id], onDelete: Cascade)

  scopeProducts   CouponScopeProduct[]
  scopeCategories CouponScopeCategory[]
  redemptions     CouponRedemption[]
  carts           Cart[]
  seasonalCampaigns SeasonalCampaign[]

  @@index([code, isActive])
  @@index([startDate, endDate])
}

model CouponScopeProduct {
  couponId  String
  coupon    Coupon  @relation(fields: [couponId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([couponId, productId])
  @@index([productId])
}

model CouponScopeCategory {
  couponId   String
  coupon     Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([couponId, categoryId])
  @@index([categoryId])
}

// One row per successful redemption, written atomically with order
// creation (order.repository.ts's createOrderWithStockDecrement). The
// sole source of truth for usage-limit enforcement: the global limit is
// COUNT(*) WHERE couponId; the per-customer limit is COUNT(*) WHERE
// couponId AND (userId = X OR guestEmail = X) — see
// docs/architecture-decisions.md for why a guest's per-customer limit can
// only be enforced once an email exists, at place-order time.
model CouponRedemption {
  id             String   @id @default(cuid())
  couponId       String
  coupon         Coupon   @relation(fields: [couponId], references: [id], onDelete: Restrict)
  userId         String?
  user           User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  guestEmail     String?
  orderId        String   @unique
  order          Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  discountAmount Decimal  @db.Decimal(10, 2)
  createdAt      DateTime @default(now())

  @@index([couponId])
  @@index([couponId, userId])
  @@index([couponId, guestEmail])
}

// Automatic, no-code discount ("10% off all products this week"). Never
// "applied" to a Cart row like a Coupon — evaluated fresh on every read,
// since by definition it requires no customer action.
model Promotion {
  id           String             @id @default(cuid())
  name         String
  // Customer-facing label shown in the order summary, e.g. "Weekend Sale
  // — 10% off all products" — distinct from `name` (admin-facing), same
  // convention as DeliveryRateOverride.campaignName being customer-visible.
  displayLabel String
  discountType CouponDiscountType
  percentOff   Decimal?           @db.Decimal(5, 2)
  amountOff    Decimal?           @db.Decimal(10, 2)
  currency     String             @default("LKR")
  startDate    DateTime
  endDate      DateTime
  minOrderValue Decimal?          @db.Decimal(10, 2)
  scope        CouponScope        @default(AllProducts)
  stackable    Boolean            @default(false)
  // Tie-break among simultaneously-eligible promotions, and against a
  // non-stackable coupon of equal discount amount (the coupon always
  // wins that tie) — lower priority wins. See docs/architecture-decisions.md.
  priority     Int                @default(0)
  isActive     Boolean            @default(true)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  scopeProducts   PromotionScopeProduct[]
  scopeCategories PromotionScopeCategory[]

  @@index([isActive, startDate, endDate])
}

model PromotionScopeProduct {
  promotionId String
  promotion   Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  productId   String
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([promotionId, productId])
  @@index([productId])
}

model PromotionScopeCategory {
  promotionId String
  promotion   Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  categoryId  String
  category    Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([promotionId, categoryId])
  @@index([categoryId])
}

// --- Rewards / Loyalty Club (STORY-030) ---
// Ledger-backed points wallet + tier/badge progression. Admin authoring of
// rule VALUES (point amounts, tier cutoffs, conversion rate, expiry
// window, badge criteria) is STORY-049's concern; the customer-facing
// wallet dashboard is STORY-035's. This story defines the schema/config
// those will later manage/read, and owns the earn/redeem/reverse/expire
// mechanics — same "build the real schema before the owning admin story
// exists" pattern STORY-027 (ShippingSetting) and STORY-029
// (Coupon/Promotion) already established. Product.rewardPoints and
// Order(Item).rewardPointsEarned (STORY-009/024/025/028) already compute
// and snapshot the EARNED AMOUNT — untouched here; this section is what
// happens to that number afterward.

enum RewardTransactionType {
  Earned
  Redeemed
  Reversed
  Expired
  // STORY-031. Distinct from Earned/Reversed on purpose: a referral bonus
  // is written with orderId = the REFERRED customer's qualifying order
  // (not the referrer's own order), and reversePointsForCancelledOrder
  // (STORY-030) already writes its own `Reversed` row against that same
  // orderId when the referred customer's own earned points are clawed
  // back — reusing `Reversed` here would collide with @@unique([orderId,
  // type]). Neither of these two count toward lifetimeAchievement (only
  // Earned/Reversed do) — referring others doesn't advance the referrer's
  // own tier.
  ReferralBonus
  ReferralBonusReversed
  // Credited once at registration (orderId null) — see
  // docs/architecture-decisions.md.
  ReferralWelcomeBonus
}

// One row per user. Caches ONLY currentTierId — never a balance, which
// stays ledger-derived per the confirmed "auditable ledger, not a single
// mutable counter" requirement (docs/architecture-decisions.md).
model RewardAccount {
  id            String      @id @default(cuid())
  userId        String      @unique
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  currentTierId String?
  currentTier   RewardTier? @relation(fields: [currentTierId], references: [id], onDelete: SetNull)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

// The ledger — sole source of truth. `points` is SIGNED: Earned > 0;
// Redeemed/Reversed/Expired <= 0. Two derived sums matter and must never
// be conflated (see docs/architecture-decisions.md):
//   spendableBalance    = SUM(points) over ALL types
//   lifetimeAchievement = SUM(points) WHERE type IN (Earned, Reversed)
// A cancelled-and-clawed-back order nets its Earned+Reversed pair to
// zero in BOTH sums. Redeeming or letting points expire reduces
// spendableBalance only — never lifetimeAchievement, so spending points
// can never demote a customer's tier.
model RewardTransaction {
  id     String                @id @default(cuid())
  userId String
  user   User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  type   RewardTransactionType
  points Int
  orderId String?
  order   Order?               @relation(fields: [orderId], references: [id], onDelete: SetNull)
  // Set only on an Earned row, only when RewardSetting.pointsExpiryDays
  // was configured at write time. Null = this batch never expires.
  expiresAt DateTime?
  // Set ONLY on an Expired row: points back to the Earned row it closes
  // out. @@unique means at most one Expired row can ever close a given
  // Earned batch — the lazy sweep (rewards.service.ts) is idempotent, a
  // re-run can never double-expire the same batch.
  expiresEarnedTransactionId String?            @unique
  expiresEarnedTransaction   RewardTransaction? @relation("EarnedExpiry", fields: [expiresEarnedTransactionId], references: [id], onDelete: SetNull)
  expiredBy                  RewardTransaction? @relation("EarnedExpiry")
  note   String?
  createdAt DateTime @default(now())

  // At most one Earned, one Redeemed, one Reversed row per order — the
  // idempotency guard for event-driven earning/clawback (a replayed
  // order.confirmed/cancelled can't double-credit/debit) and for
  // transactional redemption. An order CAN legitimately hold both a
  // Redeemed row (points spent at that order's own checkout) and later
  // an Earned row (points that same purchase earns on confirmation) —
  // different (orderId, type) pairs, so this permits it correctly.
  // Expired rows are never order-linked (orderId null; Postgres treats
  // NULL as distinct in a unique index, so many can share it).
  @@unique([orderId, type])
  @@index([userId, createdAt])
  @@index([userId, type])
}

// Admin-configurable thresholds (STORY-049 will own the authoring UI);
// seeded here with defaults so the feature works before that UI exists.
model RewardTier {
  id                String          @id @default(cuid())
  name              String          @unique
  minLifetimePoints Int             @default(0)
  sortOrder         Int             @default(0)
  isActive          Boolean         @default(true)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  accounts          RewardAccount[]

  @@index([minLifetimePoints])
}

// Extensible criteria — a plain string, not an enum, mirroring
// OrderIntegrationEvent.eventType's precedent, so a future criteria type
// never needs a migration. Evaluated by rewards.service.ts's dispatch; an
// unrecognized criteriaType fails safe (never awarded), never throws.
model Badge {
  id           String          @id @default(cuid())
  code         String          @unique
  name         String
  description  String?
  // "first_order" | "order_count" | "lifetime_points"
  criteriaType String
  // Interpreted per criteriaType; null for first_order.
  threshold    Int?
  isActive     Boolean         @default(true)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  customers    CustomerBadge[]
}

// Badges, once earned, are never revoked on order cancellation (unlike
// points) — see docs/architecture-decisions.md.
model CustomerBadge {
  id       String   @id @default(cuid())
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  badgeId  String
  badge    Badge    @relation(fields: [badgeId], references: [id], onDelete: Cascade)
  earnedAt DateTime @default(now())
  orderId  String?
  order    Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@unique([userId, badgeId])
  @@index([userId])
}

// Singleton row (id "global") — mirrors ShippingSetting's precedent.
// Every value is nullable: absence means that behavior is OFF (fails
// safe — no award/redeem, checkout still completes), never a schema
// default silently turning a feature on.
model RewardSetting {
  id                          String   @id @default("global")
  // Currency units of discount per 1 redeemed point. Null = redemption
  // disabled entirely.
  pointsToCurrencyRate        Decimal? @db.Decimal(10, 4)
  // Absolute per-order redemption cap, independent of balance. Null = no
  // separate cap (balance remains the only bound).
  maxRedeemablePointsPerOrder Int?
  // Days after which an Earned batch expires. Null = points never expire.
  // STORY-049 is the first admin UI to write this field.
  pointsExpiryDays            Int?
  // STORY-049. An additive order-value-based bonus on top of the
  // existing per-product earning (cart.service.ts::buildSummary) — not
  // a replacement mode. Null = no bonus (off by default, same
  // fail-safe convention every field on this row uses).
  orderValuePointsRate        Decimal? @db.Decimal(10, 4)
  updatedAt                   DateTime @updatedAt
}

// STORY-049. A time-boxed points multiplier, optionally scoped to one
// CustomerGroup (null = all groups) — reuses STORY-071's existing
// segmentation concept rather than inventing a parallel one. Resolved
// once per cart read (reward-campaign.service.ts::resolveActiveMultiplier)
// the same way resolveDiscountForCart already resolves coupons/promotions
// once per cart read; checkout re-reads the cart at placement time, so
// there is no separate snapshot/drift risk to manage here.
model RewardCampaign {
  id                  String         @id @default(cuid())
  name                String
  startDate           DateTime
  endDate             DateTime
  targetCustomerGroup CustomerGroup?
  pointsMultiplier    Decimal        @db.Decimal(4, 2)
  isActive            Boolean        @default(true)
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  @@index([startDate, endDate, isActive])
}

// --- Checkout (STORY-025) ---
// Thin slices of STORY-026 (Payment), STORY-027 (Shipping), and STORY-028
// (Orders) live here too — see docs/superpowers/specs/2026-09-28-checkout-design.md.

// Saved addresses exist only for authenticated users. STORY-025 (checkout)
// created this model minimally; STORY-034 owns full management (add/edit/
// delete, independent default-billing/default-shipping, business/
// distributor fields). Guest addresses are never stored here — only as the
// immutable ship* snapshot on Order (no FK from Order to Address at all —
// see docs/architecture-decisions.md's STORY-034 entry for why the AC's
// "deleting an address referenced by an order" guard doesn't apply here).
model Address {
  id                String       @id @default(cuid())
  userId            String
  user              User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  label             AddressLabel @default(Home)
  type              AddressType  @default(Both)
  recipientName     String
  phone             String
  line1             String
  line2             String?
  city              String
  // Doubles as Sri Lanka's "district" and international "state/province" —
  // same administrative-region concept, one column, label picked by
  // country in the UI. See STORY-034's architecture-decisions.md entry.
  district          String?
  postalCode        String?
  country           String       @default("LK")
  // Distributor persona (STORY-034 AC): present only when `type` covers a
  // business use; never validated as required, since most addresses aren't.
  companyName       String?
  taxId             String?
  isDefaultBilling  Boolean      @default(false)
  isDefaultShipping Boolean      @default(false)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@index([userId])
}

enum AddressLabel {
  Home
  Work
  Other
}

enum AddressType {
  Shipping
  Billing
  Both
}

enum DeliveryRateType {
  Flat
  WeightBased
  ValueBased
}

model DeliveryZone {
  id        String                 @id @default(cuid())
  name      String                 @unique
  // Matched case/whitespace-insensitively via normalizeCity(); stored
  // values keep their display casing.
  cities    String[]
  isActive  Boolean                @default(true)
  rate      DeliveryRate?
  overrides DeliveryRateOverride[]
  createdAt DateTime               @default(now())
  updatedAt DateTime               @updatedAt
}

model DeliveryRate {
  id               String           @id @default(cuid())
  zoneId           String           @unique
  zone             DeliveryZone     @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  rateType         DeliveryRateType
  flatAmount       Decimal?         @db.Decimal(10, 2)
  // [{ upTo: number, amount: string }] ascending — grams for WeightBased,
  // subtotal for ValueBased. Zod-validated at read time; malformed tiers
  // fail safe as config_error, never a silent 0 charge.
  tiers            Json?
  estimatedDaysMin Int?
  estimatedDaysMax Int?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
}

model DeliveryRateOverride {
  id             String       @id @default(cuid())
  zoneId         String
  zone           DeliveryZone @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  campaignName   String
  startsAt       DateTime
  endsAt         DateTime
  freeShipping   Boolean      @default(false)
  overrideAmount Decimal?     @db.Decimal(10, 2)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([zoneId, startsAt, endsAt])
}

// Singleton row (id "global") — the platform-wide free-shipping threshold
// is deliberately not a per-zone field (confirmed business decision).
model ShippingSetting {
  id                    String   @id @default("global")
  freeShippingThreshold Decimal  @db.Decimal(10, 2)
  updatedAt             DateTime @updatedAt
}

enum PaymentStatus {
  Pending
  Succeeded
  Failed
  Refunded
}

model Payment {
  id                String        @id @default(cuid())
  provider          String
  providerReference String        @unique
  status            PaymentStatus @default(Pending)
  amount            Decimal       @db.Decimal(10, 2)
  currency          String        @default("LKR")
  order             Order?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
}

enum OrderStatus {
  PendingConfirmation
  Confirmed
  Processing
  Dispatched
  Delivered
  Cancelled
  Returned
}

model Order {
  id                 String      @id @default(cuid())
  orderNumber        String      @unique
  idempotencyKey     String      @unique
  userId             String?
  user               User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  // Verified guest-cart token snapshot: authorizes the guest's
  // confirmation view and idempotent-replay ownership check.
  guestToken         String?
  guestEmail         String?
  status             OrderStatus @default(Confirmed)
  subtotal           Decimal     @db.Decimal(10, 2)
  deliveryCharge     Decimal     @db.Decimal(10, 2)
  discount           Decimal     @db.Decimal(10, 2) @default(0)
  tax                Decimal     @db.Decimal(10, 2) @default(0)
  grandTotal         Decimal     @db.Decimal(10, 2)
  couponCode         String?
  // STORY-029. A plain display-string snapshot of what discounted the
  // order ("Coupon SAVE10" or "Weekend Sale") — not an FK, so it survives
  // a later-deleted/deactivated Coupon or Promotion row unchanged.
  discountLabel      String?
  rewardPointsEarned Int         @default(0)
  // STORY-030. Immutable snapshots of a points redemption applied at this
  // order's checkout — mirrors the discount/discountLabel pattern.
  pointsRedeemed        Int     @default(0)
  pointsRedemptionValue Decimal @db.Decimal(10, 2) @default(0)
  erpSyncStatus      String?
  // Set together by order.service.ts's cancelOrder() (STORY-028). No
  // separate refund-reference column — refund state lives on
  // Payment.status (Refunded); duplicating it here would be a second
  // source of truth.
  cancelledAt        DateTime?
  cancellationReason String?     @db.VarChar(500)
  paymentId          String?     @unique
  payment            Payment?    @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  deliveryZoneName   String
  estimatedDaysMin   Int?
  estimatedDaysMax   Int?
  // STORY-036. Nothing writes these yet — admin console (STORY-047) will;
  // this story only reads/displays them when present.
  carrier            String?
  trackingNumber     String?
  trackingUrl        String?
  // Immutable address snapshot — flattened copies, no relation, so later
  // edits to a saved Address can never alter historical orders.
  shipRecipientName  String
  shipPhone          String
  shipLine1          String
  shipLine2          String?
  shipCity           String
  shipDistrict       String?
  shipPostalCode     String?
  items              OrderItem[]
  statusHistory      OrderStatusHistory[]
  integrationEvents  OrderIntegrationEvent[]
  couponRedemption   CouponRedemption?
  rewardTransactions RewardTransaction[]
  badgesAwarded      CustomerBadge[]
  // STORY-031. The referral this order qualified (if any) — set on the
  // attribution, not here; this is just the inverse relation.
  referralAttributions ReferralAttribution[]
  // STORY-036.
  returnRequests     ReturnRequest[]
  supportTickets     SupportTicket[]
  // STORY-047.
  refundRecords      RefundRecord[]
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  @@index([userId])
}

model OrderItem {
  id                 String   @id @default(cuid())
  orderId            String
  order              Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId          String?
  product            Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  // Snapshots at time of purchase — never rely on live product data.
  productName        String
  productSku         String
  unitPrice          Decimal  @db.Decimal(10, 2)
  quantity           Int
  lineTotal          Decimal  @db.Decimal(10, 2)
  rewardPointsEarned Int      @default(0)
}

model OrderStatusHistory {
  id        String      @id @default(cuid())
  orderId   String
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    OrderStatus
  actor     String
  createdAt DateTime    @default(now())
}

// STORY-047. Payment.status alone can only say "refunded or not" — this
// is the ledger of individual refund actions (amount, reason, who),
// since an order can in principle see more than one partial refund over
// its life even though payment.service.ts's refundPayment() only
// supports a single refund call per payment today (see
// docs/architecture-decisions.md).
model RefundRecord {
  id            String    @id @default(cuid())
  orderId       String
  order         Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  amount        Decimal   @db.Decimal(10, 2)
  reason        String    @db.VarChar(500)
  processedById String
  processedBy   AdminUser @relation(fields: [processedById], references: [id])
  createdAt     DateTime  @default(now())

  @@index([orderId])
}

// --- Order History & Support (STORY-036) ---
// Customer-facing presentation layer on top of STORY-028's Order model.
// ReturnRequest/SupportTicket are request records only — admin-side
// moderation/reply UI is out of scope here (STORY-047). See
// docs/architecture-decisions.md for the full contract.

enum ReturnRequestStatus {
  Requested
  Approved
  Rejected
  Completed
}

// STORY-047. The admin's own categorization when processing a return —
// distinct from the free-text `reason` above, which is the customer's
// own words from when they (optionally) submitted the request.
enum ReturnReasonCode {
  Damaged
  WrongItem
  NotAsDescribed
  ChangedMind
  Other
}

model ReturnRequest {
  id        String              @id @default(cuid())
  orderId   String
  order     Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  // Snapshot of the affected lines at request time — mirrors OrderItem's
  // own snapshot convention, never joins live: [{orderItemId, productName, quantity}]
  items     Json
  reason    String              @db.VarChar(1000)
  status    ReturnRequestStatus @default(Requested)
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  // STORY-047. Set when an admin processes this request (or creates one
  // directly, admin-initiated, with no prior customer submission).
  reasonCode    ReturnReasonCode?
  processedById String?
  processedBy   AdminUser?        @relation(fields: [processedById], references: [id], onDelete: SetNull)
  processedAt   DateTime?
  restocked     Boolean           @default(false)

  @@index([orderId])
}

enum SupportTicketCategory {
  OrderIssue
  Product
  Delivery
  Billing
  Other
}

enum SupportTicketStatus {
  Open
  InProgress
  Resolved
  Closed
}

// STORY-063. Customer vs AiAssistant — an orthogonal axis from
// SupportTicketCategory (topic), not a value added to that enum: a
// ticket's topic (OrderIssue/Product/...) stays meaningful for triage
// regardless of who/what opened it.
enum SupportTicketSource {
  Customer
  AiAssistant
}

model SupportTicket {
  id        String                 @id @default(cuid())
  userId    String
  user      User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderId   String?
  order     Order?                 @relation(fields: [orderId], references: [id], onDelete: SetNull)
  category  SupportTicketCategory
  subject   String
  message   String                 @db.VarChar(4000)
  status    SupportTicketStatus    @default(Open)
  // STORY-063. Both additive/nullable-or-defaulted — no existing
  // SupportTicket caller needs to change.
  source         SupportTicketSource @default(Customer)
  conversationId String?
  conversation   SupportAssistantConversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  createdAt DateTime               @default(now())
  updatedAt DateTime               @updatedAt

  @@index([userId])
  @@index([userId, status])
}

// --- Order Management (STORY-028) ---
// The ERP/warehouse integration hook: a durable outbox, not a call to any
// named ERP's API. Which ERP system is unconfirmed per blueprint.md
// Section 10 — same treatment STORY-026 gives the payment gateway. See
// docs/architecture-decisions.md for the full contract.

enum OrderIntegrationEventStatus {
  Pending
  Processed
  Failed
}

model OrderIntegrationEvent {
  id        String                      @id @default(cuid())
  orderId   String
  order     Order                       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  // "order.confirmed" | "order.cancelled" at the TS layer
  // (order-integration.service.ts's OrderEventType) — a plain string here
  // so a future event type never needs a migration.
  eventType String
  payload   Json
  status    OrderIntegrationEventStatus @default(Pending)
  processedAt DateTime?
  error     String?
  createdAt DateTime                    @default(now())

  @@index([orderId])
  @@index([status, createdAt])
}

// --- ERP Integration Console (STORY-056) ---
// A generic, connector-agnostic sync job queue — deliberately separate
// from OrderIntegrationEvent above (STORY-028's real, order-only outbox,
// which has no retry concept). Job types ("Order Export", "Stock
// Import", "Product Sync", ...) are a free string, not a closed enum,
// so a future job type never needs a migration — same reasoning as
// OrderIntegrationEvent.eventType. No real ERP is connected yet per
// docs/blueprint.md Section 10; see sync-connector.ts's stub.
enum SyncJobStatus {
  Queued
  Processing
  Success
  Failed
}

model SyncJob {
  id               String        @id @default(cuid())
  jobType          String
  status           SyncJobStatus @default(Queued)
  targetEntityType String?
  targetEntityId   String?
  payload          Json?
  errorMessage     String?
  attemptCount     Int           @default(0)
  nextRetryAt      DateTime?
  createdById      String?
  createdBy        AdminUser?    @relation(fields: [createdById], references: [id])
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  attempts         SyncJobAttempt[]

  @@index([status, createdAt])
  @@index([jobType])
}

model SyncJobAttempt {
  id            String        @id @default(cuid())
  jobId         String
  job           SyncJob       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  attemptNumber Int
  result        SyncJobStatus
  errorDetail   String?
  startedAt     DateTime      @default(now())
  completedAt   DateTime?

  @@index([jobId])
}

// --- Referral Programme (STORY-031) ---
// Every registered customer gets a shareable code (lazily generated on
// first request, or eagerly at registration). Attribution before
// registration lives ONLY in a signed cookie (src/lib/referral-token.ts)
// — no DB row until a referred visitor actually registers, mirroring the
// guest-cart pattern (no write on a mere click). ReferralAttribution is
// then created exactly once per referred customer (unique on
// referredUserId), never re-attributable afterward. Reward VALUES
// (bonus amount, minimum qualifying order value, attribution window) are
// admin-configurable (STORY-049 will own the authoring UI) — this story
// builds the real ReferralSetting schema, seeded with working defaults,
// same "build the real thing before the owning admin story exists"
// pattern STORY-027/029/030 already established. See
// docs/architecture-decisions.md for the full design.

enum ReferralAttributionStatus {
  Registered
  Qualified
  Excluded
}

model ReferralCode {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  code      String   @unique
  createdAt DateTime @default(now())
}

// One row per referred customer (never per click) — created at
// registration from whatever attribution cookie was present, if any.
model ReferralAttribution {
  id             String                    @id @default(cuid())
  referrerUserId String
  referrer       User                      @relation("Referrer", fields: [referrerUserId], references: [id], onDelete: Cascade)
  // @unique: structurally impossible to attribute the same customer
  // twice, from this or a later visit via a different referral link.
  referredUserId String                    @unique
  referred       User                      @relation("Referred", fields: [referredUserId], references: [id], onDelete: Cascade)
  status         ReferralAttributionStatus @default(Registered)
  // Free-text, extensible — e.g. "self_referral". Mirrors
  // Badge.criteriaType's "plain string, not enum" precedent.
  excludedReason String?
  qualifyingOrderId String?
  qualifyingOrder   Order?  @relation(fields: [qualifyingOrderId], references: [id], onDelete: SetNull)
  qualifiedAt    DateTime?
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt

  @@index([referrerUserId])
  @@index([status])
}

// Singleton row (id "global"). Unlike RewardSetting, this one is NOT left
// absent by default — an unconfigured referral program does nothing at
// all, so it ships seeded with real working defaults (prisma/seed-referrals.ts).
model ReferralSetting {
  id                         String   @id @default("global")
  // Points credited to the REFERRER when a referral qualifies.
  referrerBonusPoints        Int?
  // Minimum order subtotal (any currency unit the storefront uses) a
  // referred customer's order must reach to qualify. Null = any
  // confirmed order qualifies.
  minQualifyingOrderValue    Decimal? @db.Decimal(10, 2)
  // Null = falls back to a 30-day default (referral.service.ts).
  attributionWindowDays      Int?
  // Optional signup bonus for the REFERRED customer, credited once at
  // registration. Null = no welcome bonus (genuinely optional per the AC).
  referredWelcomeBonusPoints Int?
  // STORY-049. Fraud threshold — a referrer attributing more than this
  // many referrals within referralPeriodDays is flagged (FraudFlag),
  // never auto-blocked. Null on either field = this check is off.
  maxReferralsPerPeriod     Int?
  referralPeriodDays        Int?
  updatedAt                  DateTime @updatedAt
}

// --- Notifications (STORY-032) ---
// Transactional (event-triggered, one-to-one) email/SMS/WhatsApp only —
// bulk marketing campaigns are STORY-050. Message COPY is a
// NotificationTemplate row, not a hardcoded string, per CLAUDE.md's
// Admin Console Principle — seeded with real working defaults
// (prisma/seed-notifications.ts) ahead of STORY-054's future authoring
// UI, the same "build the real thing before the admin story exists"
// pattern STORY-027/029/030/031 already established. See
// docs/architecture-decisions.md for the full design.

enum NotificationChannel {
  Email
  SMS
  WhatsApp
}

enum NotificationStatus {
  Sent
  Failed
  SkippedNoConsent
}

model NotificationTemplate {
  id         String              @id @default(cuid())
  // "order.confirmed" | "order.dispatched" | "order.delivered" |
  // "order.cancelled" | "rewards.points_earned" | "referral.qualified" —
  // a plain string, not an enum, mirroring OrderIntegrationEvent.eventType's
  // precedent, so a future notification type never needs a migration.
  templateKey String
  channel    NotificationChannel
  // Email only — null for SMS/WhatsApp.
  subject    String?
  // {{variableName}} placeholders, substituted by notification.service.ts.
  body       String
  isActive   Boolean             @default(true)
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  @@unique([templateKey, channel])
}

// One row per user — mirrors RewardAccount/ReferralCode as a satellite
// table rather than bloating User with columns. Email is deliberately
// NOT gated here (see NotificationLog/notification.service.ts) — this
// table only governs the two consent-requiring channels.
model NotificationPreference {
  id            String   @id @default(cuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  phone         String?
  // Order-lifecycle transactional emails (confirmed/dispatched/etc). Named
  // `emailOptIn` (not `orderUpdatesOptIn`) since it's the only email
  // category this app currently sends — kept the original STORY-032 name
  // to avoid an unnecessary rename migration; STORY-034's "promotional
  // emails" toggle is `User.marketingOptIn` instead (same concept already
  // captured at registration — no second field for it). See
  // docs/architecture-decisions.md.
  emailOptIn    Boolean  @default(true)
  smsOptIn      Boolean  @default(false)
  whatsappOptIn Boolean  @default(false)
  // STORY-034. Points-earned / referral-qualified notifications.
  rewardUpdatesOptIn Boolean @default(true)
  updatedAt     DateTime @updatedAt
}

// One row per attempted send. `triggeringEventId` deliberately spans
// multiple source tables (OrderIntegrationEvent.id for order-lifecycle
// notifications, RewardTransaction.id for points-earned,
// ReferralAttribution.id for referral-qualified, Review.id /
// RecipeReview.id for STORY-045's review.approved/recipe_review.approved)
// rather than being a strict FK to any one of them — same "plain string
// for extensibility" treatment as OrderIntegrationEvent.eventType.
// @@unique below is the duplicate-send guard: the same fact can never
// notify the same recipient on the same channel twice.
model NotificationLog {
  id                String              @id @default(cuid())
  // Null for a guest order-confirmation email — there is no User row to link.
  userId            String?
  user              User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  recipient         String
  channel           NotificationChannel
  templateKey       String
  status            NotificationStatus
  // "smtp" | "ethereal" | "mock-sms" | "mock-whatsapp".
  provider          String?
  providerReference String?
  error             String?
  triggeringEventId String
  createdAt         DateTime            @default(now())

  // channel is part of the key deliberately — two different channels for
  // the same event/template can otherwise share an identical recipient
  // value (e.g. both fall back to the "no contact" placeholder when
  // neither SMS nor WhatsApp has a phone on file), which would wrongly
  // collide without it.
  @@unique([triggeringEventId, templateKey, channel, recipient])
  @@index([userId])
}

// STORY-050d. A bulk, ad-hoc-content send — distinct from
// NotificationTemplate's fixed system templateKeys (order.confirmed etc.),
// which a one-off marketing blast doesn't fit. Delivery is still tracked
// in the SAME NotificationLog table above (triggeringEventId: this
// campaign's id, templateKey: "campaign:{id}") rather than a second
// ledger — see email-sms-campaign.service.ts.
enum CampaignAudienceTarget {
  AllCustomers
  CustomerGroupTarget
  LoyaltyMembers
  ReferralMembers
  // STORY-059a.
  SavedSegment
}

enum CampaignStatus {
  Draft
  Scheduled
  Sent
}

model EmailSmsCampaign {
  id             String                 @id @default(cuid())
  name           String
  channel        NotificationChannel
  audienceTarget CampaignAudienceTarget
  targetCustomerGroup CustomerGroup?
  // STORY-059a. Resolved live at send time by crm-segmentation.service.ts::resolveSegmentMembers — not a frozen snapshot.
  targetSegmentId String?
  targetSegment  SavedSegment?          @relation(fields: [targetSegmentId], references: [id])
  // Email only — null for SMS/WhatsApp, mirroring NotificationTemplate.
  subject        String?
  // {{name}} merge field, substituted by notification.service.ts::renderTemplate.
  body           String
  status         CampaignStatus         @default(Draft)
  // Null = send immediately when triggered. Past-due + Scheduled rows are
  // only actually sent when an admin triggers "Send due campaigns" — no
  // cron exists in this codebase; see docs/architecture-decisions.md.
  scheduledAt    DateTime?
  sentAt         DateTime?
  createdById    String
  createdBy      AdminUser              @relation(fields: [createdById], references: [id])
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  seasonalCampaigns SeasonalCampaign[]

  @@index([status, scheduledAt])
}

// --- Admin Auth & RBAC (STORY-038) ---
// A deliberately separate authentication system from User/Account/Session
// above — a different NextAuth instance, a different session cookie, a
// different secret (ADMIN_AUTH_SECRET). No admin session can read a
// customer session or vice versa. See docs/architecture-decisions.md for
// the full design (permission matrix, cookie/secret separation, why
// RolePermission is sparse/existence-based, why Role has a separate stable
// `key` from its editable `name`).
//
// This pass ships the core only (separate auth, 12 seeded roles, the full
// permission matrix + server-side enforcement, audit logging, route
// guarding). Self-service email invite, admin password reset, and TOTP 2FA
// are explicitly deferred — see architecture-decisions.md — so AdminUser
// carries no invite/2FA fields yet; adding unused columns now would be
// speculative.

model Role {
  id            String           @id @default(cuid())
  // Stable machine identifier (e.g. "super_administrator"), separate from
  // `name` because the Super-Admin-floor and last-Super-Administrator
  // guards must key off something that survives a future rename via
  // STORY-057's role-editing UI.
  key           String           @unique
  name          String           @unique
  createdAt     DateTime         @default(now())
  adminUsers    AdminUser[]
  permissions   RolePermission[]
}

enum AdminModule {
  Products
  MediaLibrary
  HomepageBuilder
  Recipes
  Blog
  Reviews
  QA
  Orders
  Customers
  RewardsReferrals
  Marketing
  SEO
  Navigation
  CMSWorkflow
  SystemSettings
  DeliveryZones
  ERPIntegration
  UsersRolesAudit
  ExportPortal
  CRMAnalytics
  ContactEnquiries
  StoryPages
}

enum AdminAction {
  View
  Edit
  Delete
  Approve
  Export
  Audit
}

// Sparse/existence-based: a row's presence means granted, absence means
// denied. Avoids seeding ~1,440 explicit "false" rows while still
// satisfying "independently configurable per module × action cell" and
// "stored in the database, not hardcoded."
model RolePermission {
  id        String      @id @default(cuid())
  roleId    String
  role      Role        @relation(fields: [roleId], references: [id], onDelete: Cascade)
  module    AdminModule
  action    AdminAction
  createdAt DateTime    @default(now())

  @@unique([roleId, module, action])
  @@index([roleId])
}

enum AdminUserStatus {
  Active
  Locked
  Deactivated
  // STORY-057. An account created by inviteAdminUser() before the invited
  // person has accepted and set a real password — status !== "Active"
  // already rejects at login (admin-auth.service.ts), so this needs no
  // new login-gate logic.
  Invited
}

model AdminUser {
  id                 String          @id @default(cuid())
  email              String          @unique
  name               String
  passwordHash       String
  // Mirrors User.passwordChangedAt's role exactly — the JWT session-version
  // stamp checked on every request (see src/lib/admin-auth.ts). Bumping
  // this force-signs-out every outstanding session for this admin.
  passwordChangedAt  DateTime        @default(now())
  roleId             String
  role               Role            @relation(fields: [roleId], references: [id])
  status             AdminUserStatus @default(Active)
  failedLoginAttempts Int            @default(0)
  lockedUntil        DateTime?
  auditLogs          AuditLog[]
  // STORY-040.
  productsCreated    Product[]       @relation("ProductCreatedBy")
  productsUpdated    Product[]       @relation("ProductUpdatedBy")
  // STORY-041.
  mediaAssetsUploaded MediaAsset[]
  // STORY-042.
  homepageLayoutsCreated HomepageLayout[] @relation("HomepageLayoutCreatedBy")
  homepageLayoutsUpdated HomepageLayout[] @relation("HomepageLayoutUpdatedBy")
  // STORY-043.
  recipesCreated     Recipe[]        @relation("RecipeCreatedBy")
  recipesUpdated     Recipe[]        @relation("RecipeUpdatedBy")
  recipesReviewed    Recipe[]        @relation("RecipeReviewedBy")
  // STORY-044.
  blogPostsCreated   BlogPost[]      @relation("BlogPostCreatedBy")
  blogPostsUpdated   BlogPost[]      @relation("BlogPostUpdatedBy")
  // STORY-045.
  reviewsModerated       Review[]       @relation("ReviewModerator")
  recipeReviewsModerated RecipeReview[] @relation("RecipeReviewModerator")
  // STORY-046.
  questionsAnswered  Question[]      @relation("QuestionAnswerer")
  questionsApproved  Question[]      @relation("QuestionApprover")
  // STORY-046.1.
  recipeQuestionsAnswered RecipeQuestion[] @relation("RecipeQuestionAnswerer")
  recipeQuestionsApproved RecipeQuestion[] @relation("RecipeQuestionApprover")
  // STORY-047.
  refundsProcessed  RefundRecord[]
  returnsProcessed  ReturnRequest[]
  // STORY-048.
  customersSuspended User[]
  adminNotesAuthored AdminNote[]
  // STORY-049.
  fraudFlagsResolved FraudFlag[]
  // STORY-050a.
  popupsCreated      PromotionalPopup[]
  // STORY-050d.
  emailSmsCampaignsCreated EmailSmsCampaign[]
  // STORY-050e.
  landingPagesCreated LandingPage[]
  // STORY-050c.
  seasonalCampaignsCreated SeasonalCampaign[]
  // STORY-051b.
  redirectsCreated   Redirect[]
  // STORY-052.
  menusCreated       Menu[]          @relation("MenuCreatedBy")
  menusUpdated       Menu[]          @relation("MenuUpdatedBy")
  // STORY-053.
  contentVersionsCreated ContentVersion[]
  // STORY-056.
  syncJobsCreated    SyncJob[]
  // STORY-058.
  exportEnquiriesAssigned    ExportEnquiry[]      @relation("ExportEnquiryAssignee")
  exportEnquiryNotesAuthored ExportEnquiryNote[]
  distributorAccountsCreated DistributorAccount[] @relation("DistributorAccountCreatedBy")
  // STORY-059a.
  savedSegmentsCreated SavedSegment[]
  // STORY-059c.
  scheduledReportsCreated ScheduledReport[]
  // STORY-063.
  policyDocumentsUpdated PolicyDocument[]
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
}

// Minimal but real: used now for login/lockout/permission-denied events.
// Future admin-module stories (STORY-039+) call the same writeAuditLog
// helper for their own create/edit/delete/approve actions — this is the
// shared table, not a STORY-038-only log.
model AuditLog {
  id         String       @id @default(cuid())
  actorId    String?
  actor      AdminUser?   @relation(fields: [actorId], references: [id], onDelete: SetNull)
  // Free string, not the AdminAction enum — audit covers auth events
  // ("login_succeeded", "login_failed", "permission_denied",
  // "account_locked") as well as future module CRUD actions.
  action     String
  module     AdminModule?
  targetType String?
  targetId   String?
  metadata   Json?
  createdAt  DateTime     @default(now())

  @@index([actorId])
  @@index([createdAt])
}

// STORY-048. Customer-side login history — AuditLog above is
// AdminUser-only (STORY-038's admin audit trail) and never covered
// storefront logins. Written from auth.service.ts::verifyCredentials,
// the Credentials provider's sole verification path. A failed row is
// only written once a real user is matched (never for a nonexistent
// email), so this can't be used to enumerate registered addresses.
model LoginEvent {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  success   Boolean
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

// STORY-048. Internal-only support context, never surfaced on any
// customer-facing read path (profile.service.ts, etc.) — append-only,
// no edit/delete.
model AdminNote {
  id         String    @id @default(cuid())
  customerId String
  customer   User      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  authorId   String
  author     AdminUser @relation(fields: [authorId], references: [id])
  body       String    @db.VarChar(2000)
  createdAt  DateTime  @default(now())

  @@index([customerId, createdAt])
}

enum FraudFlagStatus {
  Pending
  Approved
  Reversed
}

// STORY-049. A best-effort side-effect flag written by fraud-detection
// heuristics (shared referrer/referred address, referral velocity,
// redemption velocity) — never blocks the customer action that triggers
// it. `type` is a free, extensible string (mirrors Badge.criteriaType/
// ReferralAttribution.excludedReason's precedent). An admin either
// Approves (dismiss, no reward change) or Reverses (claws back the
// related reward via rewards.service.ts::reverseTransaction).
model FraudFlag {
  id                           String           @id @default(cuid())
  customerId                   String
  customer                     User             @relation(fields: [customerId], references: [id], onDelete: Cascade)
  type                         String
  details                      Json?
  relatedRewardTransactionId   String?
  relatedReferralAttributionId String?
  status                       FraudFlagStatus  @default(Pending)
  resolvedById                 String?
  resolvedBy                   AdminUser?       @relation(fields: [resolvedById], references: [id], onDelete: SetNull)
  resolvedAt                   DateTime?
  createdAt                    DateTime         @default(now())

  @@index([customerId])
  @@index([status])
}

// STORY-050a. Promotional Pop-up Manager (docs/stories/STORY-Additional.md
// §3-9) — the first of five sub-stories split out of STORY-050 (Marketing
// Console), confirmed with the user 2026-10-02 (docs/blueprint.md Section
// 9a). Permission gating reuses the plain View/Edit/Approve AdminAction
// shape every other admin console this session built already uses, not
// the granular PROMOTION_* scheme that source doc's own section 12
// suggests — introducing a second permission model would itself be the
// "competing system" that doc's own section 15 forbids.
enum PopupStatus {
  Draft
  Scheduled
  Published
  Paused
  Unpublished
  Archived
}

// Grounded in this app's actual storefront route groups — no existing
// page-targeting system exists anywhere to reuse (Promotion/STORY-029
// only scopes to products/categories, never pages).
enum PopupPageTarget {
  AllPages
  Homepage
  Products
  Recipes
  Blog
}

// NewVisitors/ReturningVisitors can only ever be a best-effort first-party
// cookie heuristic — no visitor/session-tracking infrastructure exists
// (confirmed by the admin dashboard's own "Live Visitors: Coming soon"
// widget, STORY-039). CustomerGroupTarget reuses the same CustomerGroup
// concept RewardCampaign (STORY-049) already targets by.
enum PopupAudienceTarget {
  AllVisitors
  NewVisitors
  ReturningVisitors
  Authenticated
  CustomerGroupTarget
  LoyaltyMembers
  ReferralMembers
}

enum PopupTriggerType {
  Immediate
  TimeDelay
  ScrollDepth
  ExitIntent
  PageViews
  AddToCart
  BeforeCheckout
}

// Real, server-side enforcement only for authenticated customers
// (PopupInteraction below). A guest has no durable identity to enforce
// this against server-side yet, so guest-side capping is necessarily
// client-side (localStorage) — this app's existing "browser storage for
// a per-viewer convenience, never a hard guarantee" convention.
enum PopupFrequencyCap {
  OncePerSession
  OncePerDay
  OncePerWeek
  OncePerCustomer
  UntilDismissed
}

model PromotionalPopup {
  id                  String              @id @default(cuid())
  name                String
  status              PopupStatus         @default(Draft)
  title               String
  description         String?
  imageUrl            String?
  imageAlt            String?
  mobileImageUrl      String?
  mobileImageAlt      String?
  videoUrl            String?
  ctaLabel            String?
  ctaHref             String?
  secondaryCtaLabel   String?
  secondaryCtaHref    String?
  // Display-only — not validated against the real Coupon model yet.
  // STORY-050b (coupon management UI) wires that live integration once
  // it exists; this field's purpose until then is purely to show a code
  // in the popup's own content, same as the source spec's AC asks for.
  couponCode          String?
  pageTarget          PopupPageTarget     @default(AllPages)
  audienceTarget      PopupAudienceTarget @default(AllVisitors)
  // Only read when audienceTarget is CustomerGroupTarget.
  targetCustomerGroup CustomerGroup?
  triggerType         PopupTriggerType    @default(Immediate)
  // Seconds (TimeDelay), percent (ScrollDepth), or a page-view count
  // (PageViews) depending on triggerType — unread for every other type.
  triggerValue        Int?
  frequencyCap        PopupFrequencyCap   @default(OncePerSession)
  startAt             DateTime?
  endAt               DateTime?
  // Popups sharing a variantGroupId are A/B alternates of one another;
  // resolveEligiblePopup weighted-picks one per visit by variantWeight.
  // Not a full experimentation platform — no confidence/significance
  // tracking, just a traffic split.
  variantGroupId      String?
  variantWeight       Int                 @default(100)
  createdById         String?
  createdBy           AdminUser?          @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  interactions        PopupInteraction[]
  seasonalCampaigns   SeasonalCampaign[]

  @@index([status, startAt, endAt])
  @@index([pageTarget])
}

enum PopupInteractionType {
  Impression
  Click
  Dismissal
}

// Serves two purposes at once, deliberately — the authenticated
// frequency-cap check above, and the performance summary (impressions/
// clicks/dismissals) — one model, not a second analytics system.
model PopupInteraction {
  id        String               @id @default(cuid())
  popupId   String
  popup     PromotionalPopup     @relation(fields: [popupId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?                @relation(fields: [userId], references: [id], onDelete: SetNull)
  type      PopupInteractionType
  createdAt DateTime             @default(now())

  @@index([popupId, type])
  @@index([userId, popupId])
}

// STORY-050c. A pure linking + reporting record, deliberately NOT a new
// orchestration layer — it does not create popups/coupons/campaigns
// itself (those are built in their own consoles first, then linked
// here), and its own status does not cascade into the linked entities'
// own status (marking this "Active" never force-publishes a Draft
// popup, for example). The admin still manages each linked item's own
// lifecycle in its own console; this just groups them under one
// name/date-range and surfaces their combined performance. See
// docs/architecture-decisions.md for the full reasoning.
enum SeasonalCampaignStatus {
  Draft
  Scheduled
  Active
  Ended
  Archived
}

model SeasonalCampaign {
  id          String                 @id @default(cuid())
  name        String
  status      SeasonalCampaignStatus @default(Draft)
  startDate   DateTime
  endDate     DateTime
  popupId     String?
  popup       PromotionalPopup?      @relation(fields: [popupId], references: [id], onDelete: SetNull)
  couponId    String?
  coupon      Coupon?                @relation(fields: [couponId], references: [id], onDelete: SetNull)
  emailSmsCampaignId String?
  emailSmsCampaign   EmailSmsCampaign? @relation(fields: [emailSmsCampaignId], references: [id], onDelete: SetNull)
  homepageSectionId  String?
  homepageSection    HomepageSection?  @relation(fields: [homepageSectionId], references: [id], onDelete: SetNull)
  createdById String
  createdBy   AdminUser              @relation(fields: [createdById], references: [id])
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  @@index([status, startDate, endDate])
}

// --- Media Library (STORY-041, core scope) ---
// The reusable asset-selection source for every other content module's
// image/video field (Products STORY-040, and STORY-042/043/044 to come).
// `width`/`height` stay null until the deferred compression/WebP/variant
// pipeline lands — nothing in this pass needs them. No `MediaAssetUsage`
// table yet either: every existing image field (ProductImage.url,
// Recipe.heroImage, etc.) is still a plain string, and retrofitting them
// to a real FK-based usage guard is its own scoped follow-up — see
// docs/architecture-decisions.md.

model MediaFolder {
  id        String        @id @default(cuid())
  name      String
  parentId  String?
  parent    MediaFolder?  @relation("FolderToParent", fields: [parentId], references: [id], onDelete: SetNull)
  children  MediaFolder[] @relation("FolderToParent")
  assets    MediaAsset[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([parentId])
}

model MediaAssetTag {
  id     String       @id @default(cuid())
  name   String       @unique
  assets MediaAsset[]
}

enum MediaAssetType {
  Image
  Video
  Document
}

model MediaAsset {
  id           String          @id @default(cuid())
  // Safe, randomized on-disk name (`${cuid()}-${slugified-basename}.${ext}`)
  // — never the raw uploaded filename, so a crafted name can't traverse
  // paths or overwrite another asset's file.
  filename     String
  // The uploader's own filename, kept only for display/download naming.
  originalName String
  url          String
  mimeType     String
  type         MediaAssetType
  sizeBytes    Int
  width        Int?
  height       Int?
  // Required before AssetPickerDialog will let this asset be selected
  // (media.service.ts::assertAltTextForSelection) — enforced server-side,
  // not just a form-level nicety (AC).
  altText      String?
  folderId     String?
  folder       MediaFolder?    @relation(fields: [folderId], references: [id], onDelete: SetNull)
  tags         MediaAssetTag[]
  uploadedById String?
  uploadedBy   AdminUser?      @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([folderId])
  @@index([type])
}

// --- Homepage Visual Builder (STORY-042, core scope) ---
// The admin-side authoring model behind the storefront homepage
// (src/app/(storefront)/page.tsx, STORY-006). A layout is an ordered set
// of section instances; publishing swaps which layout is live and
// archives (never deletes) whichever layout was previously live, giving
// one-level rollback for free — see docs/architecture-decisions.md.
// Scheduling (auto-publish/expire) is deferred: no cron/job-runner exists
// in this codebase yet.

enum HomepageLayoutStatus {
  Draft
  Published
  Archived
}

enum HomepageSectionType {
  HeroBanner
  FeaturedCategories
  WhyChooseOristor
  BestSellingProducts
  FeaturedRecipes
  ProductCollections
  FoodAcademy
  CustomerReviews
  ExportSolutions
  RewardsClub
  InstagramGallery
}

enum ContentAlignment {
  Left
  Center
  Right
}

model HomepageLayout {
  id          String               @id @default(cuid())
  status      HomepageLayoutStatus @default(Draft)
  publishedAt DateTime?
  sections    HomepageSection[]
  createdById String?
  createdBy   AdminUser?           @relation("HomepageLayoutCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById String?
  updatedBy   AdminUser?           @relation("HomepageLayoutUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@index([status])
}

model HomepageSection {
  id       String              @id @default(cuid())
  layoutId String
  layout   HomepageLayout      @relation(fields: [layoutId], references: [id], onDelete: Cascade)
  type     HomepageSectionType
  sortOrder Int
  visible  Boolean             @default(true)
  // Light-touch override for the 10 non-HeroBanner types — null falls
  // back to that section's existing hardcoded/fixture heading. Unused
  // (always null) for HeroBanner, which uses HeroBannerSlide instead. A
  // layout may have at most one HeroBanner-type section (enforced in
  // homepage-builder.service.ts, not the schema — Prisma can't express a
  // conditional unique constraint); the other 10 types may repeat, since
  // duplicate-section is an explicit AC.
  titleOverride       String?
  descriptionOverride String?
  banners  HeroBannerSlide[]
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  seasonalCampaigns SeasonalCampaign[]

  @@index([layoutId])
}

model HeroBannerSlide {
  id                String           @id @default(cuid())
  sectionId         String
  section           HomepageSection  @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  sortOrder         Int
  visible           Boolean          @default(true)
  headline          String
  subheadline       String?
  supportingText    String?
  ctaLabel          String?
  ctaHref           String?
  secondaryCtaLabel String?
  secondaryCtaHref  String?
  desktopImageUrl   String
  desktopImageAlt   String
  mobileImageUrl    String?
  mobileImageAlt    String?
  videoUrl          String?
  overlayEnabled    Boolean          @default(false)
  alignment         ContentAlignment @default(Left)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([sectionId])
}

// STORY-050e. A standalone, slug-addressable campaign page — NOT built
// on HomepageLayout/HomepageSection, which are hard-wired to a single
// site-wide active homepage (homepage-builder.service.ts enforces
// exactly one Published layout). Many landing pages are independently
// live at once, a materially different invariant. LandingPageBlock's
// fields deliberately mirror HeroBannerSlide's exactly — the only
// genuinely reusable, author-from-scratch content block STORY-042
// shipped (every other section type there just toggles visibility over
// hardcoded fixture data) — and its storefront render component
// (hero-banner-slide.tsx) is imported and reused directly for both this
// model's public page and the admin preview, never duplicated.
enum LandingPageStatus {
  Draft
  Published
  Archived
}

model LandingPage {
  id              String            @id @default(cuid())
  name            String
  slug            String            @unique
  status          LandingPageStatus @default(Draft)
  metaTitle       String?
  metaDescription String?
  publishedAt     DateTime?
  blocks          LandingPageBlock[]
  createdById     String
  createdBy       AdminUser         @relation(fields: [createdById], references: [id])
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([status])
}

model LandingPageBlock {
  id                String           @id @default(cuid())
  landingPageId     String
  landingPage       LandingPage      @relation(fields: [landingPageId], references: [id], onDelete: Cascade)
  sortOrder         Int
  visible           Boolean          @default(true)
  headline          String
  subheadline       String?
  supportingText    String?
  ctaLabel          String?
  ctaHref           String?
  secondaryCtaLabel String?
  secondaryCtaHref  String?
  desktopImageUrl   String
  desktopImageAlt   String
  mobileImageUrl    String?
  mobileImageAlt    String?
  videoUrl          String?
  overlayEnabled    Boolean          @default(false)
  alignment         ContentAlignment @default(Left)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([landingPageId])
}

// STORY-052. Mega Menu is NOT a 4th location here — it's nested MenuItem
// children under whichever Header item has mega-menu content, matching
// nav-config.ts's existing NavItem.megaMenu?: MegaMenuSection[] shape. The
// admin UI still presents it as its own tab for discoverability.
enum MenuLocation {
  Header
  Footer
  Mobile
}

// Same 3-value shape as HomepageLayoutStatus — publish/rollback mirrors
// homepage-layout.repository.ts's publishLayoutSwappingPrevious exactly,
// scoped by location instead of being global.
enum MenuStatus {
  Draft
  Published
  Archived
}

// None is for a pure grouping node (a mega-menu section heading, a footer
// column heading) that isn't itself clickable.
enum MenuLinkType {
  None
  Internal
  External
}

// Scoped-down version of PopupAudienceTarget (popup.service.ts) — a nav
// item doesn't need loyalty/referral targeting, just these 3 cases.
enum MenuItemVisibility {
  Always
  Authenticated
  CustomerGroupTarget
}

enum MenuContentBlockType {
  Link
  PromoTile
}

model Menu {
  id          String       @id @default(cuid())
  location    MenuLocation
  status      MenuStatus   @default(Draft)
  publishedAt DateTime?
  items       MenuItem[]
  createdById String?
  createdBy   AdminUser?   @relation("MenuCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById String?
  updatedBy   AdminUser?   @relation("MenuUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([location, status])
}

model MenuItem {
  id       String     @id @default(cuid())
  menuId   String
  menu     Menu       @relation(fields: [menuId], references: [id], onDelete: Cascade)
  parentId String?
  parent   MenuItem?  @relation("MenuItemParent", fields: [parentId], references: [id], onDelete: Cascade)
  children MenuItem[] @relation("MenuItemParent")
  sortOrder Int

  label        String
  linkType     MenuLinkType @default(None)
  internalPath String?
  externalUrl  String?
  openInNewTab Boolean      @default(false)
  // A curated name key into src/lib/menu-icons.ts's MENU_ICON_OPTIONS map,
  // not a free string — never rendered as raw HTML/executable content.
  icon String?

  visibility          MenuItemVisibility @default(Always)
  targetCustomerGroup CustomerGroup?
  active              Boolean            @default(true)

  // Only meaningful for Mega Menu children (location: Header, depth 2).
  contentBlockType MenuContentBlockType @default(Link)
  promoImageUrl    String?
  promoImageAlt    String?
  promoHeading     String?
  promoCtaLabel    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([menuId, parentId])
}

// STORY-053 (additive scope). A generic, entity-agnostic version
// snapshot — entityType is a free string, not a closed enum like
// SeoEntityType, specifically so a future content type can start
// calling versioning.service.ts::recordVersion() without a schema
// migration. Deliberately NOT a replacement for HomepageLayout's/
// Recipe's/BlogPost's own status enums or transition guards — see
// docs/architecture-decisions.md's 2026-10-03 053 entry for why this
// story stayed additive instead of retrofitting those three already-
// shipped modules onto one shared state machine.
model ContentVersion {
  id            String     @id @default(cuid())
  entityType    String
  entityId      String
  versionNumber Int
  snapshot      Json
  createdById   String?
  createdBy     AdminUser? @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt     DateTime   @default(now())

  @@unique([entityType, entityId, versionNumber])
  @@index([entityType, entityId])
}

// STORY-054. Each of the following is a singleton row (id: "global",
// upserted) — the same pattern ShippingSetting/RewardSetting already
// established — except PaymentMethodSetting/FeatureFlag, which are
// genuinely lists.

model CompanySetting {
  id                     String   @id @default("global")
  legalName              String?
  brandName              String?
  logoUrl                String?
  logoAlt                String?
  address                String?
  phone                  String?
  email                  String?
  businessRegistrationId String?
  taxId                  String?
  // {label, href}[] — small and unstructured enough not to need its own table.
  socialLinks            Json?
  // STORY-072. Free text (e.g. "Mon-Fri, 9am-5pm") — no business-hours field
  // existed anywhere before this; admin-filled via System Settings, omitted
  // from the Contact page entirely if unset, never fabricated.
  businessHours          String?
  // STORY-074. The Contact page's hero copy and location heading — the
  // only still-hardcoded text on that page (everything else already
  // reads from this model). Singleton strings, not a repeating list, so
  // they live here rather than in StoryPageBlock. Falls back to the
  // page's original literal copy when unset, same pattern as
  // businessHours/address/phone above.
  contactHeroEyebrow     String?
  contactHeroHeadline    String?
  contactHeroSubcopy     String?
  contactLocationHeading String?
  updatedAt              DateTime @updatedAt
}

// STORY-074. Admin-editable content blocks for the About page (originally
// shipped as the fully-static src/lib/story-content.ts in STORY-073).
// One flat-fields table covers all 7 of the page's content shapes — each
// leaves only a few fields null (e.g. ValueItem never uses image/CTA
// fields) — matching HeroBannerSlide's own flat-typed-fields convention
// rather than a JSON blob. Scoped to a `page` enum (currently only
// AboutUs) so a future static page can reuse this model instead of
// inventing a parallel one.
enum StoryPage {
  AboutUs
}

enum StoryBlockType {
  Hero
  Chapter
  IngredientItem
  ProductCategoryItem
  ValueItem
  GlobalJourney
  Cta
}

model StoryPageBlock {
  id                String            @id @default(cuid())
  page              StoryPage
  blockType         StoryBlockType
  // Stable per-row key (e.g. "hero", "the-land", "ingredient-chilli",
  // "category-pickles", "value-o", "global-journey", "cta") — the admin
  // save route upserts by (page, blockKey) so a full-page re-save never
  // needs to juggle generated ids.
  blockKey          String
  sortOrder         Int               @default(0)
  eyebrow           String?
  title             String?
  body              String?           @db.VarChar(4000)
  imageUrl          String?
  imageAlt          String?
  ctaLabel          String?
  ctaHref           String?
  secondaryCtaLabel String?
  secondaryCtaHref  String?
  // Chapter only; reuses the existing enum rather than a second left|right type.
  align             ContentAlignment?
  // ValueItem only (the O-R-I-S-T-O-R acrostic letter).
  letter            String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@unique([page, blockKey])
  @@index([page, blockType, sortOrder])
}

model CurrencySetting {
  id                  String   @id @default("global")
  baseCurrency        String   @default("LKR")
  supportedCurrencies String[] @default(["LKR"])
  // {[currencyCode]: rate} manual override — no automated rate source
  // exists or is scoped yet (multi-currency launch scope is still open,
  // docs/blueprint.md Section 10).
  manualExchangeRates Json?
  updatedAt           DateTime @updatedAt
}

model LocaleSetting {
  id               String   @id @default("global")
  defaultLocale    String   @default("en")
  supportedLocales String[] @default(["en"])
  updatedAt        DateTime @updatedAt
}

enum TaxPricingDisplayMode {
  Inclusive
  Exclusive
}

model TaxSetting {
  id                 String                @id @default("global")
  pricingDisplayMode TaxPricingDisplayMode @default(Exclusive)
  updatedAt          DateTime              @updatedAt
}

model TaxRateRule {
  id          String   @id @default(cuid())
  region      String
  category    String?
  ratePercent Decimal  @db.Decimal(5, 2)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([region, category])
}

// key is a free string, not an enum — same "no migration for a new
// one" reasoning as STORY-053's ContentVersion.entityType. The actual
// payment gateway provider(s) are still unconfirmed (blueprint Section
// 10), so this lists configured methods generically rather than
// hardcoding one gateway's shape.
model PaymentMethodSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  label     String
  enabled   Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model FeatureFlag {
  id          String   @id @default(cuid())
  key         String   @unique
  enabled     Boolean  @default(false)
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Replaces admin-dashboard.service.ts's hardcoded LOW_STOCK_THRESHOLD
// constant — docs/blueprint.md's own "Known deferred/leftover items"
// list ties it to this story by name.
model InventorySetting {
  id                String   @id @default("global")
  lowStockThreshold Int      @default(10)
  updatedAt         DateTime @updatedAt
}

// --- Instagram integration (Settings > Integrations) ---
// Backs the storefront's "Follow @oristorfoods" homepage section. A Page
// Access Token (resolved server-side from the admin's one-time short-lived
// token paste — see instagram.service.ts) is long-lived but not eternal,
// so tokenExpiresAt/lastSyncedAt/lastSyncError exist for the admin UI to
// show real connection health rather than a feed that silently goes stale.
model InstagramIntegrationSetting {
  id                String    @id @default("global")
  // Resolved from the Facebook Page linked to the connected Instagram
  // Business account — never typed in by hand.
  businessAccountId String?
  // Page Access Token. Never returned to the client — every read path
  // masks it (see instagram.service.ts::getIntegrationStatus).
  accessToken       String?
  tokenExpiresAt    DateTime?
  lastSyncedAt      DateTime?
  lastSyncError     String?
  updatedAt         DateTime  @updatedAt
}

// Cached copy of the connected account's recent media. Images are
// downloaded into local media storage at sync time (LocalDiskStorageProvider,
// same as MediaAsset) rather than linking Instagram's own CDN url directly —
// that url is a temporary signed link that rotates/expires, which would
// silently 404 on the homepage between syncs otherwise.
model InstagramPost {
  // Instagram's own media id — stable across re-syncs, so syncing upserts
  // rather than duplicates.
  id        String   @id
  imageUrl  String
  permalink String
  caption   String?  @db.VarChar(2200)
  postedAt  DateTime
  syncedAt  DateTime @default(now())

  @@index([postedAt])
}

// --- Export Portal (STORY-058) ---

enum ExportEnquiryStatus {
  New
  InDiscussion
  Quoted
  Won
  Lost
}

// Submitted anonymously via the public /export storefront form — no
// User relation at submission time. productsOfInterest/volumeEstimate
// are free-text, not a Product relation: the AC's "filterable by ...
// product interest" is satisfied by a contains search, same shape as
// other free-text admin filters in this codebase (e.g. AuditLog.targetId).
model ExportEnquiry {
  id                 String              @id @default(cuid())
  companyName        String
  contactName        String
  contactEmail       String
  contactPhone       String?
  country            String
  productsOfInterest String
  volumeEstimate     String?
  message            String              @db.VarChar(4000)
  status             ExportEnquiryStatus @default(New)
  assignedToId       String?
  assignedTo         AdminUser?          @relation("ExportEnquiryAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  notes              ExportEnquiryNote[]
  distributorAccount DistributorAccount?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@index([status])
  @@index([country])
  @@index([assignedToId])
}

// Strictly internal — never visible to the enquirer (AC). A reply sent
// to the enquirer is tracked via writeAuditLog instead, not here; see
// docs/architecture-decisions.md's STORY-058 entry.
model ExportEnquiryNote {
  id        String        @id @default(cuid())
  enquiryId String
  enquiry   ExportEnquiry @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
  authorId  String
  author    AdminUser     @relation(fields: [authorId], references: [id])
  body      String        @db.VarChar(2000)
  createdAt DateTime      @default(now())

  @@index([enquiryId])
}

// Created only by converting a Won ExportEnquiry. `userId` links a real
// User (customerGroup set to Distributor at conversion time) so the
// distributor actually receives STORY-071's CustomerGroupPrice tiered
// pricing at checkout — this is not a CRM-only record.
model DistributorAccount {
  id                     String        @id @default(cuid())
  companyName            String
  region                 String
  contactName            String
  contactEmail           String
  contactPhone           String?
  userId                 String        @unique
  user                   User          @relation(fields: [userId], references: [id])
  convertedFromEnquiryId String        @unique
  convertedFromEnquiry   ExportEnquiry @relation(fields: [convertedFromEnquiryId], references: [id])
  createdById            String
  createdBy              AdminUser     @relation("DistributorAccountCreatedBy", fields: [createdById], references: [id])
  createdAt              DateTime      @default(now())
}

// --- CRM Segmentation (STORY-059a) ---

// filterCriteria mirrors AuditLog.metadata's Json-column convention:
// Prisma.InputJsonValue on the write side, a real Zod-validated
// SegmentFilterCriteria TS interface (crm-segmentation.schema.ts) for
// the actual shape. Segments are live — resolveSegmentMembers()
// re-runs the filter at read/send time rather than storing a frozen
// member list.
model SavedSegment {
  id             String             @id @default(cuid())
  name           String
  filterCriteria Json
  createdById    String
  createdBy      AdminUser          @relation(fields: [createdById], references: [id])
  campaigns      EmailSmsCampaign[]
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
}

enum ScheduledReportFrequency {
  Weekly
  Monthly
}

// STORY-059c. No cron exists in this codebase (same constraint
// email-sms-campaign.service.ts's processDueCampaigns already
// documents) — a due row is only actually sent when an admin
// triggers "Send due reports now"; lastSentAt is how that action
// decides what's due.
model ScheduledReport {
  id          String                   @id @default(cuid())
  // "sales" | "customers" | "products-recipes" | "funnel" |
  // "executive-summary" — a plain string, not an enum, mirroring
  // OrderIntegrationEvent.eventType/NotificationTemplate.templateKey's
  // established precedent, so a future report type never needs a migration.
  reportType  String
  recipients  String[]
  frequency   ScheduledReportFrequency
  lastSentAt  DateTime?
  createdById String
  createdBy   AdminUser                @relation(fields: [createdById], references: [id])
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt
}

// STORY-060. AI Product Recommendations.

enum ProductInteractionEventType {
  View
  AddToCart
  WishlistAdd
}

// VIEW/ADD_TO_CART/WISHLIST_ADD only — deliberately no Purchase type.
// Order/OrderItem already captures purchases with full fidelity
// (userId, productId, quantity, createdAt); every recommendation
// strategy reads purchase signal from there directly rather than
// duplicating it into a second table.
model ProductInteractionEvent {
  id         String                       @id @default(cuid())
  customerId String?
  customer   User?                        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  // Anonymous-visitor correlation only — a lightweight, unsigned
  // crypto.randomUUID() cookie value, NOT Cart.guestToken's signed
  // HMAC mechanism (that guards cart content integrity, a materially
  // higher-stakes concern than this soft personalization signal).
  sessionId  String?
  productId  String
  product    Product                      @relation(fields: [productId], references: [id], onDelete: Cascade)
  eventType  ProductInteractionEventType
  createdAt  DateTime                     @default(now())

  @@index([customerId])
  @@index([productId])
}

enum ProductAssociationType {
  Similar
  FrequentlyBoughtTogether
}

// Precomputed by recommendation.service.ts::recomputeProductAssociations
// (admin-triggered — no cron exists in this codebase, same constraint
// STORY-050d/STORY-059c already resolved the same way). Every read
// path reads these rows directly; nothing computes similarity live.
model ProductAssociation {
  id               String                 @id @default(cuid())
  sourceProductId  String
  sourceProduct    Product                @relation("AssociationSource", fields: [sourceProductId], references: [id], onDelete: Cascade)
  targetProductId  String
  targetProduct    Product                @relation("AssociationTarget", fields: [targetProductId], references: [id], onDelete: Cascade)
  associationType  ProductAssociationType
  score            Float
  computedAt       DateTime               @default(now())

  @@unique([sourceProductId, targetProductId, associationType])
  @@index([sourceProductId, associationType])
}

enum RecommendationPlacement {
  Homepage
  Pdp
  Cart
}

enum RecommendationAction {
  Impression
  Click
  AddToCart
}

// Telemetry for a product shown AS A RECOMMENDATION specifically —
// distinct from ProductInteractionEvent's general behavior signal,
// since the server has no way to know a product was shown as a
// recommendation vs. organically without the client reporting it.
model RecommendationEvent {
  id         String                   @id @default(cuid())
  customerId String?
  customer   User?                    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  sessionId  String?
  placement  RecommendationPlacement
  productId  String
  product    Product                  @relation(fields: [productId], references: [id], onDelete: Cascade)
  action     RecommendationAction
  createdAt  DateTime                 @default(now())

  @@index([productId])
  @@index([placement, action])
}

// STORY-061. AI Smart Search.

// One embedding per product, upserted by embedding.service.ts on
// publish/update and by the admin-triggered recompute (no cron exists
// in this codebase — same constraint STORY-050d/STORY-059c/STORY-060
// already resolved the same way). All reads/writes go through
// embedding.repository.ts's raw SQL — Unsupported("vector(N)") isn't
// readable/writable through the generated client directly.
model ProductEmbedding {
  id           String                      @id @default(cuid())
  productId    String                      @unique
  product      Product                     @relation(fields: [productId], references: [id], onDelete: Cascade)
  embedding    Unsupported("vector(1536)")
  modelVersion String
  updatedAt    DateTime                    @updatedAt
}

enum ContentSourceType {
  Recipe
  BlogPost
  FoodAcademyEntry
}

// Polymorphic by (sourceType, sourceId) — deliberately no FK to
// Recipe/BlogPost/FoodAcademyEntry (a single relation can't target
// three different tables), the same plain-reference pattern
// AuditLog.targetId/OrderIntegrationEvent already use for this shape.
model ContentEmbedding {
  id           String            @id @default(cuid())
  sourceType   ContentSourceType
  sourceId     String
  embedding    Unsupported("vector(1536)")
  modelVersion String
  updatedAt    DateTime          @updatedAt

  @@unique([sourceType, sourceId])
}

// Real sink for search.service.ts::logProductSearch, a typed hook
// point STORY-012 already left explicitly for this story (and
// STORY-064) — previously console.debug-only outside production.
// embeddingTokens is OpenAI's own reported usage.total_tokens, not an
// estimated dollar figure (see docs/architecture-decisions.md) — null
// when the semantic layer didn't run for this query.
model SearchQueryLog {
  id              String   @id @default(cuid())
  query           String
  resultCount     Int
  isZeroResult    Boolean
  embeddingTokens Int?
  customerId      String?
  customer        User?    @relation(fields: [customerId], references: [id], onDelete: SetNull)
  sessionId       String?
  createdAt       DateTime @default(now())

  @@index([createdAt])
  @@index([isZeroResult])
}

// Sinhala/Tamil dish/ingredient transliteration + general synonym
// glossary, admin-managed (Admin Console Principle — see
// docs/architecture-decisions.md for why this ships with zero seeded
// entries rather than fabricated ones). targetType/targetId are
// optional: most terms are plain synonym expansions (e.g. "hot" ->
// "spicy") with no single target; a term CAN optionally point at one
// specific catalog record when it unambiguously maps to one.
model SearchGlossaryTerm {
  id            String   @id @default(cuid())
  term          String   @unique
  canonicalTerm String
  targetType    String?
  targetId      String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// STORY-062. AI Recipe Assistant.

// One conversation thread. customerId is nullable (guest, correlated
// via the shared rec_sid cookie — see recommendation-session.ts)
// following SearchQueryLog's own nullable-FK convention.
model RecipeAssistantConversation {
  id            String                   @id @default(cuid())
  customerId    String?
  customer      User?                    @relation(fields: [customerId], references: [id], onDelete: SetNull)
  sessionId     String?
  startedAt     DateTime                 @default(now())
  lastMessageAt DateTime                 @default(now())
  messages      RecipeAssistantMessage[]

  @@index([customerId])
  @@index([sessionId])
  @@index([lastMessageAt])
}

enum RecipeAssistantMessageRole {
  User
  Assistant
}

// structuredPayload is the guardrail-validated {message,
// recommendedRecipeIds, clarifyingQuestion} shape for an Assistant
// row — null for a User row, and null for a graceful-fallback
// Assistant row (no structured data to show, just the apology text).
// promptTokens/completionTokens are OpenAI's own reported usage, same
// real-not-estimated standard as SearchQueryLog.embeddingTokens.
model RecipeAssistantMessage {
  id                String                       @id @default(cuid())
  conversationId    String
  conversation      RecipeAssistantConversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role              RecipeAssistantMessageRole
  content           String
  structuredPayload Json?
  promptTokens      Int?
  completionTokens  Int?
  createdAt         DateTime                     @default(now())

  @@index([conversationId, createdAt])
}

// STORY-063. AI Customer Support Assistant.

// escalated tracks whether this conversation led to a real
// SupportTicket (STORY-036) — see SupportTicket.source/conversationId
// above. The security-critical identity-exclusivity invariant
// (customerId XOR sessionId, enforced at the route layer, re-checked
// strictly in support-assistant.service.ts) lives here: once a
// conversation has a non-null customerId, a sessionId-only match
// attempt against it must be rejected outright, never treated as an
// OR-fallback. See docs/architecture-decisions.md.
model SupportAssistantConversation {
  id             String                     @id @default(cuid())
  customerId     String?
  customer       User?                      @relation(fields: [customerId], references: [id], onDelete: SetNull)
  sessionId      String?
  startedAt      DateTime                   @default(now())
  lastMessageAt  DateTime                   @default(now())
  escalated      Boolean                    @default(false)
  messages       SupportAssistantMessage[]
  supportTickets SupportTicket[]

  @@index([customerId])
  @@index([sessionId])
  @@index([lastMessageAt])
}

enum SupportAssistantMessageRole {
  User
  Assistant
}

// structuredPayload is the guardrail-validated {message,
// referencedOrderNumbers, requiresSignIn, escalate, escalationReason,
// confidenceScore} shape — same real-token-logging standard as
// RecipeAssistantMessage/SearchQueryLog.
model SupportAssistantMessage {
  id                String                       @id @default(cuid())
  conversationId    String
  conversation      SupportAssistantConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role              SupportAssistantMessageRole
  content           String
  structuredPayload Json?
  confidenceScore   Float?
  promptTokens      Int?
  completionTokens  Int?
  createdAt         DateTime                     @default(now())

  @@index([conversationId, createdAt])
}

// The single canonical policy content source (AC #4) — admin-managed
// under System Settings, ships with no seeded content (no real
// returns/refund/exchange policy text exists anywhere in this
// codebase to seed it with; inventing one would be fabrication, the
// same standard STORY-061's empty glossary set). slug is free-string
// and extensible (e.g. "returns-refunds-exchanges"), not a closed
// enum, matching this codebase's FeatureFlag/TaxRateRule key
// convention for an open-ended admin-defined set.
model PolicyDocument {
  id          String    @id @default(cuid())
  slug        String    @unique
  title       String
  content     String
  updatedById String?
  updatedBy   AdminUser? @relation(fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// STORY-064. RFM-based churn risk — classical statistics computed from
// customer-segment.repository.ts::getCustomerMetrics(), not an LLM
// feature (same precedent as STORY-060's recommendation logic).
// signalBreakdown records engagementSignalsAvailable: false — no
// site-visit/email-open tracking exists anywhere in this codebase, so
// that half of the churn definition is honestly omitted, never
// fabricated.
enum ChurnRiskTier {
  Low
  Medium
  High
}

model CustomerChurnScore {
  id              String        @id @default(cuid())
  customerId      String        @unique
  customer        User          @relation(fields: [customerId], references: [id], onDelete: Cascade)
  score           Float
  riskTier        ChurnRiskTier
  signalBreakdown Json
  computedAt      DateTime      @default(now())

  @@index([riskTier])
}

// STORY-064. One row per scheduled-batch-job recompute per metric
// type/period. periodStart/periodEnd are real DateTime fields (not a
// free-text label) so "has today's job already run for this window?"
// and "latest snapshot per metricType" are real range queries, not
// string parsing — a greenfield decision, no existing snapshot-style
// model in this codebase to match a convention from.
// sourceQueryRef grounds every narrative claim in the real query that
// produced it (AC #6); structuredPayload carries a CampaignSuggestion
// row's {title, rationale, suggestedProductIds, suggestedFilterCriteria}
// — the real data the "Send to Marketing" action acts on.
enum BusinessInsightMetricType {
  Trend
  Anomaly
  CampaignSuggestion
}

model BusinessInsightSnapshot {
  id                String                    @id @default(cuid())
  periodStart       DateTime
  periodEnd         DateTime
  metricType        BusinessInsightMetricType
  narrativeText     String
  sourceQueryRef    Json
  structuredPayload Json?
  // Discriminator within one recompute batch — Trend/Anomaly always use
  // sequence 0 (exactly one row per period); CampaignSuggestion uses
  // 0..N-1, one row per suggested idea in that batch, each independently
  // actionable from the UI. Needed because the unique constraint below
  // would otherwise cap every metricType at one row per period.
  sequence          Int                       @default(0)
  generatedAt       DateTime                  @default(now())

  @@index([metricType, generatedAt])
  @@unique([metricType, periodStart, periodEnd, sequence])
}

// STORY-072. Covers every Contact Us enquiry type EXCEPT Export/International
// Business, which routes into the existing ExportEnquiry pipeline (STORY-058)
// instead — see architecture-decisions.md's STORY-072 entry. Field naming
// (contactName/contactEmail/contactPhone, message @db.VarChar(4000))
// deliberately matches ExportEnquiry's own naming for the same concept. No
// assignedTo-style field: unlike ExportEnquiry's pipeline, this story's ACs
// never ask for admin assignment.
enum ContactEnquiryType {
  General
  Product
  CustomerSupport
  Wholesale
  Distributor
  RetailPartnership
  FoodService
  Media
  Careers
  Other
}

enum ContactEnquiryStatus {
  New
  InProgress
  Responded
  Closed
  Spam
}

model ContactEnquiry {
  id              String               @id @default(cuid())
  contactName     String
  contactEmail    String
  contactPhone    String?
  companyName     String?
  country         String?
  enquiryType     ContactEnquiryType
  businessType    String?
  productInterest String?
  message         String               @db.VarChar(4000)
  status          ContactEnquiryStatus @default(New)
  source          String               @default("contact-page")
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@index([status])
  @@index([enquiryType])
  @@index([createdAt])
}
